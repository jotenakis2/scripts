#!/usr/bin/env bash
# shellcheck enable=all
##############################################################################
# freeim — remplacement lisible de « free », à partir de /proc/meminfo et /sys.
#
# Auteur original : jotenakis (GPLv3). Réécriture corrective 2026.
#
# Aucune dépendance externe : tout est calculé en bash (ni bc, ni sed, ni
# grep, ni xargs, ni tput pour les couleurs). Les couleurs sont des séquences
# ANSI directes, désactivées hors terminal, avec --nocolor ou NO_COLOR.
#
# Options : -h/--help  -v/--version  -s/--simple  -n/--nocolor  -f/--free
#           -0/--noexplain  -m/--mib
##############################################################################
set -euo pipefail

readonly version="3.0.1"
readonly name="${0##*/}"
export LC_NUMERIC=C

# État
declare -i SIMPLE=0 HELP=0 VER=0 NOEXPLAIN=0 FREE=0 NOCOLOR=0 FORCE_MIB=0
declare -i TTY=0 cols=110
declare -i ZRAM_DETECTED=0 ZSWAP_DETECTED=0
declare -i mem_total=0 mem_avail=0 mem_free=0 mem_used=0
declare -i buffers=0 cached=0 anon=0 shmem=0 dirty=0 writeback=0 hardwarecorrupted=0
declare -i kernel_mem=0 sreclaimable=0 sunreclaim=0
declare -i zswap=0 zswapped=0 swap_total=0 swap_free=0 swap_used=0 swapcached=0
declare -i zram_size=0 zram_data=0 zram_used=0
declare swap_devices="" comp_algo_zswap="" comp_algo_zram=""
declare mem_used_pct="0.0" mem_free_pct="0.0" swap_used_pct="0.0" swap_free_pct="0.0"
declare SZ="" SZ_C=""

# Couleurs (vides par défaut = aucune séquence ANSI)
C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_CYAN="" Reset=""

##############################################################################
# Utilitaires
##############################################################################
err() { printf 'Erreur : %s\n' "$*" >&2; }

enable_colors() {
    if (( TTY == 1 )) && (( NOCOLOR == 0 )) && [[ -z "${NO_COLOR:-}" ]] \
        && [[ "${TERM:-dumb}" != "dumb" ]]; then
        C_RED=$'\033[31m'
        C_GREEN=$'\033[32m'
        C_YELLOW=$'\033[33m'
        C_BLUE=$'\033[34m'
        C_CYAN=$'\033[36m'
        Reset=$'\033[0m'
    fi
    return 0
}

detect_cols() {
    local c=""
    if (( TTY == 1 )); then
        c=$(tput cols 2>/dev/null || true)
    fi
    [[ "${c}" =~ ^[0-9]+$ ]] || c="${COLUMNS:-110}"
    [[ "${c}" =~ ^[0-9]+$ ]] || c=110
    (( c > 110 )) && c=110     # évite des cadres démesurés sur grand écran
    (( c < 50 ))  && c=50      # plancher lisible
    cols=$(( c - 1 ))          # marge de sécurité : pas de retour à la ligne
    return 0
}

# $1 = KiB -> renseigne SZ (texte) et SZ_C (couleur)
size_fmt() {
    local kb=$1 d
    if (( FORCE_MIB == 1 )); then
        SZ="$(( kb / 1024 )) MiB"
        SZ_C="${C_YELLOW}"
    elif (( kb >= 1048576 )); then
        d=$(( kb * 10 / 1048576 ))
        SZ="$(( d / 10 )).$(( d % 10 )) GiB"
        SZ_C="${C_RED}"
    elif (( kb >= 1024 )); then
        SZ="$(( kb / 1024 )) MiB"
        SZ_C="${C_YELLOW}"
    else
        SZ="${kb} KiB"
        SZ_C="${C_GREEN}"
    fi
    return 0
}

# $1 = dixièmes de pourcent -> renseigne PCT
pct_fmt() {
    local n=$1
    PCT="$(( n / 10 )).$(( n % 10 ))"
}

# Cadre coloré (ou simple bandeau si la sortie n'est pas un terminal)
title() {
    local color=$1
    shift
    local text="$*"
    if (( TTY == 0 )); then
        printf '>>> %s <<<\n' "${text}"
        return 0
    fi
    local fg=""
    case "${color}" in
        red) fg="${C_RED}" ;; green) fg="${C_GREEN}" ;; yellow) fg="${C_YELLOW}" ;;
        blue) fg="${C_BLUE}" ;; cyan) fg="${C_CYAN}" ;; *) fg="" ;;
    esac
    local w=$(( cols - 2 ))
    (( w < 10 )) && return 0
    local len=${#text}
    if (( len > w )); then
        text="${text:0:w}"
        len=${w}
    fi
    local padl padr
    padl=$(( (w - len) / 2 ))
    padr=$(( w - len - padl ))
    local hline
    printf -v hline '%*s' "${w}" ''
    hline="${hline// /═}"
    printf '%s╔%s╗%s\n' "${fg}" "${hline}" "${Reset}"
    printf '%s║%*s%s%*s║%s\n' "${fg}" "${padl}" '' "${text}" "${padr}" '' "${Reset}"
    printf '%s╚%s╝%s\n' "${fg}" "${hline}" "${Reset}"
    return 0
}

# Ligne principale : "Label             :       15.0 GiB   40.5%"
emit_main() {
    local label=$1 kb=$2 pct=${3:-}
    local pad lp
    size_fmt "${kb}"
    pad=$(( 18 - ${#SZ} ))
    lp=$(( 18 - ${#label} ))
    (( pad < 0 )) && pad=0
    (( lp < 0 )) && lp=0
    if [[ -n "${pct}" ]]; then
        printf '%s%*s: %*s%s%s%s   %s%5s%%%s\n' \
            "${label}" "${lp}" '' "${pad}" '' "${SZ_C}" "${SZ}" "${Reset}" "${C_BLUE}" "${pct}" "${Reset}"
    else
        printf '%s%*s: %*s%s%s%s\n' \
            "${label}" "${lp}" '' "${pad}" '' "${SZ_C}" "${SZ}" "${Reset}"
    fi
    return 0
}

# Ligne de détail : "  Label           :     834 MiB   (explication)"
emit_detail() {
    local label=$1 kb=$2 expl=${3:-}
    local pad lp
    size_fmt "${kb}"
    pad=$(( 18 - ${#SZ} ))
    lp=$(( 16 - ${#label} ))
    (( pad < 0 )) && pad=0
    (( lp < 0 )) && lp=0
    if [[ -n "${expl}" ]]; then
        local room=$(( cols - 41 ))
        if (( room < 12 )); then
            expl=""
        elif (( ${#expl} > room )); then
            expl="${expl:0:$(( room - 1 ))}…"
        fi
    fi
    if [[ -n "${expl}" ]]; then
        printf '  %s%*s: %*s%s%s%s   %s\n' \
            "${label}" "${lp}" '' "${pad}" '' "${SZ_C}" "${SZ}" "${Reset}" "${expl}"
    else
        printf '  %s%*s: %*s%s%s%s\n' \
            "${label}" "${lp}" '' "${pad}" '' "${SZ_C}" "${SZ}" "${Reset}"
    fi
    return 0
}

##############################################################################
# Options
##############################################################################
show_version() {
    printf '%sversion %s%s%s\n' "${C_GREEN}" "${C_BLUE}" "${version}" "${Reset}"
    return 0
}

show_help() {
    local saved_cols=${cols}
    (( cols > 80 )) && cols=80
    title cyan "AIDE"
    cols=${saved_cols}
    printf '%s[Description]%s\n' "${C_BLUE}" "${Reset}"
    printf '%s=> %s calcule et affiche les données d'"'"'occupation de la mémoire virtuelle.%s\n\n' "${C_GREEN}" "${name}" "${Reset}"
    printf '%s=> %s n'"'"'utilise que les données de /proc et /sys.%s\n\n' "${C_GREEN}" "${name}" "${Reset}"
    printf '%s=> Les unités sont ajustées automatiquement avec un affichage coloré.%s\n' "${C_GREEN}" "${Reset}"
    printf '   - GiB = Go = giga-octets (facteur 1024), en %srouge%s.\n' "${C_RED}" "${Reset}"
    printf '   - MiB = Mo = mega-octets (facteur 1024), en %sjaune%s.\n' "${C_YELLOW}" "${Reset}"
    printf '   - KiB = Ko = kilo-octets (facteur 1024), en %svert%s.\n\n' "${C_GREEN}" "${Reset}"
    printf '%s[Options]%s\n' "${C_BLUE}" "${Reset}"
    printf '%s  --simple,    -s, -S%s : affichage concis.\n' "${C_YELLOW}" "${Reset}"
    printf '%s  --nocolor,   -n, -N%s : affichage non coloré (ou NO_COLOR).\n' "${C_YELLOW}" "${Reset}"
    printf '%s  --free,      -f, -F%s : affichage comme la commande free.\n' "${C_YELLOW}" "${Reset}"
    printf '%s  --noexplain, -0    %s : affichage sans explication.\n' "${C_YELLOW}" "${Reset}"
    printf '%s  --mib,       -m, -M%s : affichage forcé en MiB.\n' "${C_YELLOW}" "${Reset}"
    printf '%s  --help,      -h, -H%s : affichage de l'"'"'aide.\n' "${C_YELLOW}" "${Reset}"
    printf '%s  --version,   -v, -V%s : affichage du numéro de version.\n\n' "${C_YELLOW}" "${Reset}"
    printf '%s[Dépendance]%s\n' "${C_BLUE}" "${Reset}"
    printf '  %saucune%s : tout est calculé en bash (ni bc, ni sed, ni grep).\n\n' "${C_GREEN}" "${Reset}"
    return 0
}

parse_options() {
    local opt
    local OPTIND=1
    while getopts ":fFhHvVsSnN0mM-:" opt; do
        # '-' + ':' dans l'optstring : getopts renvoie '-' pour les options longues
        # shellcheck disable=SC2214
        case "${opt}" in
            f|F) FREE=1 ;;
            h|H) HELP=1 ;;
            v|V) VER=1 ;;
            s|S) SIMPLE=1 ;;
            n|N) NOCOLOR=1 ;;
            0)   NOEXPLAIN=1 ;;
            m|M) FORCE_MIB=1 ;;
            -)
                case "${OPTARG}" in
                    free)      FREE=1 ;;
                    help)      HELP=1 ;;
                    version)   VER=1 ;;
                    simple)    SIMPLE=1 ;;
                    nocolor)   NOCOLOR=1 ;;
                    noexplain) NOEXPLAIN=1 ;;
                    mib)       FORCE_MIB=1 ;;
                    *) err "option inconnue : --${OPTARG}"; exit 1 ;;
                esac
                ;;
            :)
                err "l'option -${OPTARG} attend un argument"
                exit 1
                ;;
            \?)
                err "option inconnue : -${OPTARG}"
                exit 1
                ;;
            *)
                err "erreur inattendue dans getopts"
                exit 1
                ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    if (( $# > 0 )); then
        err "argument inattendu : $1"
        exit 1
    fi
    return 0
}

##############################################################################
# Lecture de /proc et /sys
##############################################################################
compute_meminfo() {
    local -A mem=()
    local key value _ d10
    local -i kernel_stack page_tables vmalloc_used percpu

    while IFS=': ' read -r key value _; do
        [[ -n "${key}" ]] && mem["${key%%[[:space:]]*}"]="${value%%[[:space:]]*}"
    done </proc/meminfo

    mem_total=${mem[MemTotal]:-0}
    mem_avail=${mem[MemAvailable]:-0}
    mem_free=${mem[MemFree]:-0}
    mem_used=$(( mem_total - mem_avail))
    if (( mem_total > 0 )); then
        d10=$(( mem_used * 1000 / mem_total ))
    else
        d10=0
    fi
    pct_fmt "${d10}"      ; mem_used_pct="${PCT}"
    pct_fmt $(( 1000 - d10 )); mem_free_pct="${PCT}"

    buffers=${mem[Buffers]:-0}
    cached=${mem[Cached]:-0}
    anon=${mem[AnonPages]:-0}
    shmem=${mem[Shmem]:-0}
    dirty=${mem[Dirty]:-0}
    writeback=${mem[Writeback]:-0}
    hardwarecorrupted=${mem[HardwareCorrupted]:-0}
    sreclaimable=${mem[SReclaimable]:-0}
    sunreclaim=${mem[SUnreclaim]:-0}
    kernel_stack=${mem[KernelStack]:-0}
    page_tables=${mem[PageTables]:-0}
    vmalloc_used=${mem[VmallocUsed]:-0}
    percpu=${mem[Percpu]:-0}
    # Noyau = mémoire non récupérable (SUnreclaim) + piles + tables + vmalloc + percpu.
    # SReclaimable est exclu : c'est du cache libérable (déjà du côté « Cache » de free).
    kernel_mem=$(( sunreclaim + kernel_stack + page_tables + vmalloc_used + percpu ))

    zswap=${mem[Zswap]:-0}
    zswapped=${mem[Zswapped]:-0}
    swap_total=${mem[SwapTotal]:-0}
    swap_free=${mem[SwapFree]:-0}
    swapcached=${mem[SwapCached]:-0}
    swap_used=$(( swap_total - swap_free ))
    if (( swap_total > 0 )); then
        d10=$(( swap_used * 1000 / swap_total ))
    else
        d10=0
    fi
    pct_fmt "${d10}"      ; swap_used_pct="${PCT}"
    pct_fmt $(( 1000 - d10 )); swap_free_pct="${PCT}"
    return 0
}

# Extrait l'algorithme actif d'un fichier comp_algorithm : "lzo lz4 [lz4hc]"
read_active_algo() {   # $1 = fichier -> stdout (peut être vide)
    local line=""
    [[ -r "$1" ]] || return 0
    line=$(<"$1")
    if [[ "${line}" =~ \[([^]]+)\] ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
    return 0
}

detect_swap() {
    local filename num syszram algo
    local -i disksize=0 data=0 used=0
    local -a algos=()

    if [[ -r /proc/swaps ]]; then
        while read -r filename _ _ _ _; do
            [[ "${filename}" == "Filename" ]] && continue
            [[ -n "${filename}" ]] || continue
            swap_devices="${swap_devices:+${swap_devices} }${filename}"
            if [[ "${filename}" == /dev/zram* ]]; then
                ZRAM_DETECTED=1
                num="${filename##*zram}"
                syszram="/sys/block/zram${num}"
                if [[ -r "${syszram}/disksize" ]]; then
                    disksize=$(<"${syszram}/disksize")
                    zram_size=$(( zram_size + disksize / 1024 ))
                fi
                if [[ -r "${syszram}/mm_stat" ]]; then
                    read -r data _ used _ <"${syszram}/mm_stat" || true
                    zram_data=$(( zram_data + data / 1024 ))
                    zram_used=$(( zram_used + used / 1024 ))
                fi
                algo=$(read_active_algo "${syszram}/comp_algorithm")
                [[ -n "${algo}" ]] && algos+=("${algo}")
            fi
        done </proc/swaps
    fi
    if (( ${#algos[@]} > 0 )); then
        local a out=""
        for a in "${algos[@]}"; do
            [[ " ${out} " == *" ${a} "* ]] && continue
            out="${out:+${out},}${a}"
        done
        comp_algo_zram="${out}"
    fi

    if [[ -r /sys/module/zswap/parameters/enabled ]]; then
        if [[ "$(< /sys/module/zswap/parameters/enabled)" == "Y" ]]; then
            ZSWAP_DETECTED=1
            if [[ -r /sys/module/zswap/parameters/compressor ]]; then
                comp_algo_zswap=$(< /sys/module/zswap/parameters/compressor)
            fi
        fi
    fi
    return 0
}

##############################################################################
# Affichage
##############################################################################
display_RAM_extended() {
    local expl_buffer="" expl_cache="" expl_anon="" expl_shmem=""
    local expl_kernel="" expl_dirty="" expl_writeback="" expl_corrupted=""

    printf '\n%sDétails%s\n' "${C_CYAN}" "${Reset}"
    if (( NOEXPLAIN == 0 )); then
        expl_buffer="(mémoire utilisée pour optimiser les entrées/sorties des disques)"
        expl_cache="(mémoire utilisée pour mettre en cache les fichiers lus)"
        expl_anon="(mémoire utilisée par les processus/applications)"
        expl_shmem="(mémoire partagée, tmpfs et certains GPU intégrés)"
        expl_kernel="(mémoire non récupérable du noyau Linux)"
        expl_dirty="(mémoire en attente d'écriture sur les disques)"
        expl_writeback="(mémoire en cours d'écriture sur les disques)"
        expl_corrupted="(mémoire marquée comme corrompue par le noyau Linux)"
    fi

    emit_detail "Tampons"   "${buffers}"           "${expl_buffer}"
    emit_detail "Cache"     "${cached}"            "${expl_cache}"
    emit_detail "Anonyme"   "${anon}"              "${expl_anon}"
    emit_detail "Partagée"  "${shmem}"             "${expl_shmem}"
    emit_detail "Noyau"     "${kernel_mem}"        "${expl_kernel}"
    emit_detail "Attente"   "${dirty}"             "${expl_dirty}"
    emit_detail "Écriture"  "${writeback}"         "${expl_writeback}"
    emit_detail "Corrompue" "${hardwarecorrupted}" "${expl_corrupted}"
    return 0
}

display_RAM() {
    title cyan "Mémoire vive (RAM)"
    emit_main "Totale"     "${mem_total}"
    emit_main "Utilisée"   "${mem_used}" "${mem_used_pct}"
    emit_main "Disponible" "${mem_avail}" "${mem_free_pct}"
    emit_main "Libre"      "${mem_free}"
    if (( SIMPLE == 0 )); then
        display_RAM_extended
    fi
    return 0
}

# Bloc zswap ou zram (les textes sont passés en argument : pas de portée dynamique)
display_swap_comp() {
    local back=$1 algo=$2 pool_max=$3 pool_used=$4 data=$5
    local exp_pool=$6 exp_used=$7 exp_data=$8
    local d10 ratio pad

    printf '  %s%*s: %s%s(%s)%s\n' "Compression" $(( 16 - 11 )) '' "${C_BLUE}" "${back}" "${algo}" "${Reset}"
    emit_detail "Swap en cache" "${swapcached}" ""
    emit_detail "Pool ${back} max" "${pool_max}" "${exp_pool}"
    emit_detail "Pool ${back}" "${pool_used}" "${exp_used}"
    if (( data > 0 )); then
        emit_detail "Données ${back}" "${data}" "${exp_data}"
        if (( pool_used > 0 )); then
            d10=$(( data * 10 / pool_used ))
            ratio="$(( d10 / 10 )).$(( d10 % 10 ))"
            pad=$(( 18 - ${#ratio} - 1 ))
            (( pad < 0 )) && pad=0
            printf '  %s%*s: %*s%sx%s%s\n' "Efficacité" $(( 16 - 10 )) '' "${pad}" '' "${C_BLUE}" "${ratio}" "${Reset}"
        fi
    fi
    return 0
}

display_SWAP_extended() {
    local exp_pool="" exp_zswap="" exp_zswapped="" exp_zram="" exp_zrammed=""
    local exp_zramsize=""
    local dev
    local -i pc_zswap=20 pool_zswap=0

    printf '\n%sDétails%s\n' "${C_CYAN}" "${Reset}"
    if (( NOEXPLAIN == 0 )); then
        exp_pool="(mémoire utilisable par zswap)"
        exp_zswap="(mémoire utilisée par zswap)"
        exp_zswapped="(valeur non compressée des données en zswap)"
        exp_zram="(mémoire utilisée par zram)"
        exp_zrammed="(valeur non compressée des données en zram)"
        exp_zramsize="(mémoire utilisable par zram)"
    fi

    for dev in ${swap_devices}; do
        printf '  %s%*s: %s%s%s\n' "Périphérique" $(( 16 - 12 )) '' "${C_BLUE}" "${dev}" "${Reset}"
    done

    if (( ZSWAP_DETECTED == 1 )); then
        if [[ -r /sys/module/zswap/parameters/max_pool_percent ]]; then
            pc_zswap=$(< /sys/module/zswap/parameters/max_pool_percent)
            [[ "${pc_zswap}" =~ ^[0-9]+$ ]] || pc_zswap=20
        fi
        pool_zswap=$(( pc_zswap * mem_total / 100 ))
        display_swap_comp "Zswap" "${comp_algo_zswap}" "${pool_zswap}" "${zswap}" "${zswapped}" \
            "${exp_pool}" "${exp_zswap}" "${exp_zswapped}"
    fi
    if (( ZRAM_DETECTED == 1 )); then
        display_swap_comp "Zram" "${comp_algo_zram}" "${zram_size}" "${zram_used}" "${zram_data}" \
            "${exp_zramsize}" "${exp_zram}" "${exp_zrammed}"
    fi
    return 0
}

display_SWAP() {
    printf '\n'
    title cyan "Espace d'échange (SWAP)"
    emit_main "Total"      "${swap_total}"
    emit_main "Utilisé"    "${swap_used}" "${swap_used_pct}"
    emit_main "Disponible" "${swap_free}" "${swap_free_pct}"
    if (( SIMPLE == 0 )); then
        display_SWAP_extended
    fi
    return 0
}

# Tableau au format de « free » (colonnes de 12, alignées à droite)
free_cell() {   # VAR texte couleur
    local p
    p=$(( 12 - ${#2} ))
    (( p < 0 )) && p=0
    printf -v "$1" '%*s%s%s%s' "${p}" '' "$3" "$2" "${Reset}"
    return 0
}

display_as_free() {
    local c1 c2 c3 c4 c5 c6
    local -i bufcache

    free_cell c1 "total"      "";        free_cell c2 "utilisé"   ""
    free_cell c3 "libre"      "";        free_cell c4 "partagé"   ""
    free_cell c5 "tamp/cache" "";        free_cell c6 "disponible" ""
    printf '%-6s%s%s%s%s%s%s\n' "" "${c1}" "${c2}" "${c3}" "${c4}" "${c5}" "${c6}"

    bufcache=$(( buffers + cached + sreclaimable ))
    size_fmt "${mem_total}";      free_cell c1 "${SZ}" "${SZ_C}"
    size_fmt "${mem_used}";       free_cell c2 "${SZ}" "${SZ_C}"
    size_fmt "${mem_free}";       free_cell c3 "${SZ}" "${SZ_C}"
    size_fmt "${shmem}";          free_cell c4 "${SZ}" "${SZ_C}"
    size_fmt "${bufcache}";       free_cell c5 "${SZ}" "${SZ_C}"
    size_fmt "${mem_avail}";      free_cell c6 "${SZ}" "${SZ_C}"
    printf '%-6s%s%s%s%s%s%s\n' "Mem :" "${c1}" "${c2}" "${c3}" "${c4}" "${c5}" "${c6}"

    if (( swap_total > 0 )); then
        size_fmt "${swap_total}"; free_cell c1 "${SZ}" "${SZ_C}"
        size_fmt "${swap_used}";  free_cell c2 "${SZ}" "${SZ_C}"
        size_fmt "${swap_free}";  free_cell c3 "${SZ}" "${SZ_C}"
        printf '%-6s%s%s%s\n' "Swap:" "${c1}" "${c2}" "${c3}"
    fi
    return 0
}

##############################################################################
# Main
##############################################################################
main() {
    TTY=0
    [[ -t 1 ]] && TTY=1

    parse_options "$@"
    enable_colors
    detect_cols

    if (( HELP == 1 )); then show_help; fi
    if (( VER == 1 )); then show_version; fi
    (( HELP == 1 || VER == 1 )) && exit 0

    compute_meminfo
    detect_swap

    if (( FREE == 1 )); then
        display_as_free
        exit 0
    fi

    display_RAM
    if [[ -n "${swap_devices}" ]]; then
        display_SWAP
    elif (( SIMPLE == 0 && NOEXPLAIN == 0 )); then
        printf '\n%sNote%s\n  %s%s%s n'"'"'a pas détecté d'"'"'espace d'"'"'échange (swap).\n' \
            "${C_CYAN}" "${Reset}" "${C_GREEN}" "${name}" "${Reset}"
    fi
    return 0
}

main "$@"
