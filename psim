# Construit le bandeau dans les variables globales plain/colored.
TIPS_BUILD() {
    local -i long="$1"
    local -a sp sc
    local cc cm cp cpp cu cC co ck ch cf ct cF
    local -i budget i

    cc="${BleuBold}"; cm="${BleuBold}"; cp="${BleuBold}"; cpp="${BleuBold}"
    cu="${BleuBold}"; cC="${BleuBold}"; co="${BleuBold}"; ck="${BleuBold}"
    ch="${BleuBold}"; cf="${BleuBold}"; ct="${BleuBold}"; cF="${BleuBold}"
    cM="${BleuBold}"; cN="${BleuBold}"
    case "${SORT}" in
        -%cpu|%cpu) cc="${VertBold}" ;;
        -rss|rss)   cm="${VertBold}" ;;
        -pid|pid)   cp="${VertBold}" ;;
        -ppid|ppid) cpp="${VertBold}" ;;
        -user|user) cu="${VertBold}" ;;
        -cmd|cmd)   cC="${VertBold}" ;;
        -nice|nice) cN="${VertBold}" ;;
        *) : ;;
    esac
    (( KERNEL != 0 ))    && ck="${VertBold}"
    (( HEADER == 1 ))    && ch="${VertBold}"
    (( FOOTER == 1 ))    && cf="${VertBold}"
    (( TIPS == 1 ))      && ct="${VertBold}"
    (( FREEZE == 1 ))    && cF="${VertBold}"
    (( SHOW_OPTS == 1 )) && co="${VertBold}"
    (( CPU_MODE == 1 ))  && cM="${VertBold}"

    mode_icon="${ICON_MODE}"
    (( long == 1 )) || mode_icon="${ICON_MODE_SHORT}"

    if (( long == 1 )); then
        sp=( "[c]pu" "[M]achine" "[m]em" "[p]id" "[P]pid" "[N]ice" "[u]ser" "[C]md"
             "[o]ptions" "[k]ernel" "[h]eader" "[f]ooter" "[t]ips" "[/]filtre" )
        sc=( "${cc}[c]${ResetFg}pu" "${cM}[M]${ResetFg}achine" "${cm}[m]${ResetFg}em"
             "${cp}[p]${ResetFg}id" "${cpp}[P]${ResetFg}pid" "${cN}[N]${ResetFg}ice"
             "${cu}[u]${ResetFg}ser" "${cC}[C]${ResetFg}md" "${co}[o]${ResetFg}ptions"
             "${ck}[k]${ResetFg}ernel"
             "${ch}[h]${ResetFg}eader" "${cf}[f]${ResetFg}ooter" "${ct}[t]${ResetFg}ips"
             "${BleuBold}[/]${ResetFg}filtre" )
        tail_p=" | [+/-]refresh | [F]reeze ${ICON_CLOCK}  ${int}${scroll}"
        tail_c=" ${Gris}|${ResetFg} ${BleuBold}[+/-]${ResetFg}refresh ${Gris}|${ResetFg} ${cF}[F]${ResetFg}reeze ${Vert}${ICON_CLOCK}  ${int}${Gris}${scroll}${ResetFg}"
    else
        sp=( "[c]pu" "[M]" "[m]em" "[p]id" "[P]pid" "[N]" "[u]ser" "[C]md" "[o]"
             "[k]" "[h]" "[f]" "[t]" "[/]" )
        sc=( "${cc}[c]${ResetFg}pu" "${cM}[M]${ResetFg}" "${cm}[m]${ResetFg}em"
             "${cp}[p]${ResetFg}id" "${cpp}[P]${ResetFg}pid" "${cN}[N]${ResetFg}"
             "${cu}[u]${ResetFg}ser" "${cC}[C]${ResetFg}md" "${co}[o]${ResetFg}"
             "${ck}[k]${ResetFg}"
             "${ch}[h]${ResetFg}" "${cf}[f]${ResetFg}" "${ct}[t]${ResetFg}"
             "${BleuBold}[/]${ResetFg}" )
        tail_p=" [+/-] [F] ${ICON_CLOCK}  ${int}${scroll}"
        tail_c=" ${BleuBold}[+/-]${ResetFg} ${cF}[F]${ResetFg} ${Vert}${ICON_CLOCK}  ${int}${Gris}${scroll}${ResetFg}"
    fi

    # segments toujours affichés : mode, défilement, quitter
    crit_p=" [${mode_icon}]mode | [${ICON_SCROLL}]scroll | [q]uit"

    budget=$(( WIDTH - 1 - ${#lead} - ${#crit_p} - ${#tail_p} - ${#filt_p} ))
    (( budget < 0 )) && budget=0

    plain="${lead}"
    colored="${lead}"
    first=1
    for i in "${!sp[@]}"; do
        local seg_p=" ${sp[i]}"
        (( ${#seg_p} <= budget )) || continue
        budget=$(( budget - ${#seg_p} ))
        if (( long == 1 && first == 0 )); then
            plain+=" | ${sp[i]}"
            colored+=" ${Gris}|${ResetFg} ${sc[i]}"
        else
            plain+=" ${sp[i]}"
            colored+=" ${sc[i]}"
        fi
        first=0
    done

    if (( long == 1 && first == 0 )); then
        plain+=" | [${mode_icon}]mode | [${ICON_SCROLL}]scroll | [q]uit"
        colored+=" ${Gris}|${ResetFg} ${BleuBold}[${mode_icon}]${ResetFg}mode ${Gris}|${ResetFg} ${BleuBold}[${ICON_SCROLL}]${ResetFg}scroll ${Gris}|${ResetFg} ${BleuBold}[q]${ResetFg}uit"
    else
        # pas de segment de tri : mode/scroll/quit démarrent le bandeau
        plain+=" [${mode_icon}]mode [${ICON_SCROLL}]scroll [q]uit"
        colored+=" ${BleuBold}[${mode_icon}]${ResetFg}mode ${BleuBold}[${ICON_SCROLL}]${ResetFg}scroll ${BleuBold}[q]${ResetFg}uit"
    fi

    plain+="${tail_p}${filt_p}"
    colored+="${tail_c}${filt_c}"
    return 0
}

# Construit filt_p / filt_c : motif, état de saisie, éventuel « invalide ».
FILTER_INDICATOR() {
    local label="${FILTER}" suffix="" color="${Jaune}" room
    filt_p=""
    filt_c=""
    if (( FILTER_EDIT == 1 )); then
        label="/${FILTER}"
        suffix="_"
    fi
    (( FILTER_INVALID == 1 )) && color="${RougeBold}"
    [[ -n "${label}" ]] || return 0
    room=$(( WIDTH / 3 ))
    (( room < 8 )) && room=8
    (( ${#label} > room )) && label="${label:0:room}>"
    filt_p=" ${label}${suffix}"
    filt_c=" ${color}${label}${ResetFg}${suffix}"
    if (( FILTER_INVALID == 1 )); then
        filt_p+=" invalide"
        filt_c+=" ${RougeBold}invalide${ResetFg}"
    fi
    return 0
}

# Ligne minimale : uniquement le motif (utilisée quand le bandeau est masqué,
# pour ne jamais être aveugle sur le filtre en cours).
PRINT_TIPS_MIN() {
    FILTER_INDICATOR
    [[ -n "${filt_c}" ]] || return 0
    if [[ -n "${BgGris}" ]]; then
        printf '%s%s\033[K%s' "${Reset}${BgGris}" "${filt_c}" "${Reset}"
    else
        printf '%s' "${filt_c}"
    fi
    return 0
}

PRINT_TIPS() {
    local int scroll="" room trimmed
    local -i long

    (( OFFSET > 0 )) && scroll=" [+${OFFSET}]"
    int="${INTERVAL}s"
    (( FREEZE == 1 )) && int="GEL"
    lead=" ${ICON_LEAD}  "

    FILTER_INDICATOR

    # bandeau complet seulement sur écran large (comme psim), puis version courte
    for long in 1 0; do
        (( long == 1 && WIDTH < 150 )) && continue
        TIPS_BUILD "${long}"
        (( ${#plain} <= WIDTH )) && break
    done

    if (( ${#plain} > WIDTH )); then
        # bandeau trop long : on tronque, en gardant le marqueur de filtre
        trimmed="${plain:0:WIDTH}"
        [[ -z "${FILTER}" ]] || trimmed="${plain:0:$(( WIDTH > 0 ? WIDTH - 1 : 0 ))}>"
        if [[ -n "${BgGris}" ]]; then
            printf '%s%s\033[K%s' "${Reset}${BgGris}" "${trimmed}" "${Reset}"
        else
            printf '%s' "${trimmed}"
        fi
    elif [[ -n "${BgGris}" ]]; then
        printf '%s%s\033[K%s' "${Reset}${BgGris}" "${colored}" "${Reset}"
    else
        printf '%s' "${colored}"
    fi
    return 0
}

##############################################################################
# Clavier
##############################################################################
SORT_TOGGLE() {
    if [[ "${SORT}" == "$1" ]]; then SORT="$2"; else SORT="$1"; fi
    return 0
}

READ_DRAWN() {
    local drawn="0" found="0"
    if [[ -n "${DRAW_FILE}" && -s "${DRAW_FILE}" ]]; then
        read -r drawn found < "${DRAW_FILE}" || true
    fi
    [[ "${drawn}" =~ ^[0-9]+$ ]] || drawn=0
    [[ "${found}" =~ ^[0-9]+$ ]] || found=0
    TOTAL=$((found))
    return 0
}

# Mode saisie du filtre : chaque caractère met FILTER à jour (rendu en direct).
FILTER_EDIT_KEY() {
    local key="$1" seq=""
    case "${key}" in
        $'\e')
            read -rt 0.05 -n 2 seq 2>/dev/null || true
            if [[ -z "${seq}" ]]; then      # Échap seul : on annule
                FILTER="${FILTER_SAVE}"
                FILTER_EDIT=0
                OFFSET=0
            fi
            ;;                              # sinon (flèche) : ignorée
        ''|$'\r'|$'\n') FILTER_EDIT=0 ;;    # Entrée (read -n 1 rend une chaîne vide)
        $'\x7f'|$'\b')                      # Retour arrière
            FILTER_BUF="${FILTER_BUF%?}"
            FILTER="${FILTER_BUF}"
            OFFSET=0
            ;;
        $'\x15')                            # Ctrl-U : efface tout
            FILTER_BUF=""
            FILTER=""
            OFFSET=0
            ;;
        *)                                    # caractère imprimable
            FILTER_BUF+="${key}"
            FILTER="${FILTER_BUF}"
            OFFSET=0
            ;;
    esac
    return 0
}

HANDLE_KEY() {
    local key seq
    local -i max_off

    local -i rc=0
    read -rt "${INTERVAL}" -n 1 key 2>/dev/null || rc=$?
    if (( rc != 0 )); then
        # 1 = EOF (entrée fermée) : on ne tourne pas à vide
        (( rc > 128 )) || sleep "${INTERVAL}"
        return 0
    fi

    if (( FILTER_EDIT == 1 )); then
        FILTER_EDIT_KEY "${key}"
        return 0
    fi

    if [[ "${key}" == $'\e' ]]; then
        read -rt 0.05 -n 2 seq 2>/dev/null || true
        key+="${seq}"
    fi

    case "${key}" in
        /) FILTER_EDIT=1; FILTER_SAVE="${FILTER}"; FILTER_BUF="${FILTER}"; OFFSET=0 ;;
        o) SHOW_OPTS=$((1 - SHOW_OPTS)) ;;
        k) KERNEL=$(( (KERNEL + 1) % 3 )) ;;
        h) HEADER=$((1 - HEADER)) ;;
        f) FOOTER=$((1 - FOOTER)) ;;
        t|'?') TIPS=$((1 - TIPS)) ;;   # '? = alias de t
        q|Q) QUIT 0 ;;
        +)
            if (( INTERVAL >= 120 )); then INTERVAL=120; else INTERVAL=$((INTERVAL + 1)); fi
            FREEZE=0
            ;;
        -)
            if (( INTERVAL > 120 )); then INTERVAL=120; else INTERVAL=$(( INTERVAL > 1 ? INTERVAL - 1 : 1 )); fi
            FREEZE=0
            ;;
        F)
            if (( FREEZE == 1 )); then
                FREEZE=0
                INTERVAL=1
            else
                FREEZE=1
                INTERVAL="${INTERVAL_MAX}"
            fi
            ;;
        c) SORT_TOGGLE "-%cpu" "%cpu"; OFFSET=0 ;;
        C) SORT_TOGGLE "cmd" "-cmd"; SHOW_OPTS=1; OFFSET=0 ;;
        N) SORT_TOGGLE "nice" "-nice"; OFFSET=0 ;;
        u) SORT_TOGGLE "user" "-user"; OFFSET=0 ;;
        p) SORT_TOGGLE "pid" "-pid"; OFFSET=0 ;;
        P) SORT_TOGGLE "ppid" "-ppid"; OFFSET=0 ;;
        m) SORT_TOGGLE "-rss" "rss"; OFFSET=0 ;;
        M) CPU_MODE=$((1 - CPU_MODE)) ;;
        $'\e[D') NEWBIE=1 ;;
        $'\e[C') NEWBIE=0 ;;
        $'\e[A') (( OFFSET > 0 )) && OFFSET=$((OFFSET - 1)) ;;
        $'\e[B')
            READ_DRAWN
            max_off=$(( TOTAL - LIMIT ))
            (( max_off < 0 )) && max_off=0
            (( OFFSET < max_off )) && OFFSET=$((OFFSET + 1))
            ;;
        $'\e[H') OFFSET=0 ;;
        $'\e[F')
            READ_DRAWN
            max_off=$(( TOTAL - LIMIT ))
            (( max_off < 0 )) && max_off=0
            OFFSET="${max_off}"
            ;;
        *) : ;;
    esac
    return 0
}

##############################################################################
# Modes
##############################################################################
RUN_DYNAMIC() {
    local -i max_off
    ALT=1
    STTY_SAVE=$(stty -g 2>/dev/null || true)
    [[ -z "${STTY_SAVE}" ]] || stty -echo 2>/dev/null || true
    printf '\033[?25l\033[?1049h\033[H'
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP

    while :; do
        READ_SIZE
        if (( WIDTH < MIN_W || HEIGHT < MIN_H )); then
            RESTORE_SCREEN
            ERR "terminal trop petit (${WIDTH}x${HEIGHT}), minimum ${MIN_W}x${MIN_H}."
            QUIT 1
        fi
        (( WIDTH < THIN_W )) && NEWBIE=1

        local -i bar=0
        if (( TIPS == 1 || FILTER_EDIT == 1 )) || [[ -n "${FILTER}" ]]; then
            bar=1
        fi

        LIMIT=$(( HEIGHT - HEADER - FOOTER - bar ))
        (( LIMIT < 1 )) && LIMIT=1

        READ_DRAWN
        max_off=$(( TOTAL - LIMIT ))
        (( max_off < 0 )) && max_off=0
        (( OFFSET > max_off )) && OFFSET="${max_off}"

        printf '\033[H'
        RENDER 1 "${LIMIT}" "${HEADER}" "${FOOTER}"
        if (( bar == 1 )); then
            # pas d'effacement ici : la ligne du bandeau est réécrite par-dessus
            # (un \033[J la blanchirait avant de la redessiner -> scintillement)
            printf '\n'
            if (( TIPS == 1 )); then PRINT_TIPS; else PRINT_TIPS_MIN; fi
        else
            # pas de bandeau : on nettoie ce qui reste sous le pied de page
            printf '\033[J'
        fi

        HANDLE_KEY
    done
}

RUN_STATIC() {
    READ_SIZE
    (( WIDTH < THIN_W )) && NEWBIE=1
    RENDER "${TTY}" "${LIMIT}" "${HEADER}" "${FOOTER}"
    return 0
}

##############################################################################
# Journal / statistiques
##############################################################################
ROTATE_LOG() {
    local -i size
    [[ -f "${LOG_FILE}" ]] || return 0
    size=$(wc -c < "${LOG_FILE}" 2>/dev/null || printf '0')
    [[ "${size}" =~ ^[0-9]+$ ]] || size=0
    (( size > LOG_MAX )) && mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
    return 0
}

WRITE_LOG() {
    local psver awkver
    (( LOG == 1 )) && [[ -n "${LOG_FILE}" ]] || return 0
    ROTATE_LOG
    psver=$("${PS_BIN}" --version 2>/dev/null | head -n 1 || true)
    awkver=$("${AWK_BIN}" --version 2>/dev/null | head -n 1 || true)
    [[ -n "${awkver}" ]] || awkver=$("${AWK_BIN}" -W version 2>/dev/null | head -n 1 || true)
    {
        printf '=== %s — %s %s ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${NAME}" "${VER}"
        printf 'durée       : %ss\n' "${SECONDS}"
        printf 'utilisateur : %s\n' "${ME}"
        printf 'terminal    : %sx%s (%s)\n' "${WIDTH}" "${HEIGHT}" "${TERM:-?}"
        printf 'ps          : %s (%s)\n' "${PS_BIN}" "${psver}"
        printf 'awk         : %s (%s)\n' "${AWK_BIN}" "${awkver}"
        printf 'tri         : %s | filtre : %s\n' "${SORT}" "${FILTER}"
        printf 'newbie      : %s | noyau : %s | options : %s\n' "${NEWBIE}" "${KERNEL}" "${SHOW_OPTS}"
        printf 'entête      : %s | pied : %s | bandeau : %s | couleur : %s\n' \
            "${HEADER}" "${FOOTER}" "${TIPS}" "$(( NO_COLOR == 0 ? 1 : 0 ))"
        printf '\n'
    } >> "${LOG_FILE}" 2>/dev/null || true
    chmod 600 "${LOG_FILE}" 2>/dev/null || true
    return 0
}


##############################################################################
# Sortie
##############################################################################
ON_EXIT() {
    local -i rc=$?
    if (( CLEANED == 1 )); then return 0; fi
    CLEANED=1
    RESTORE_SCREEN
    if (( SESSION == 1 )); then
        [[ -z "${DRAW_FILE}" ]] || rm -f "${DRAW_FILE}" 2>/dev/null || true
        WRITE_LOG
    fi
    return "${rc}"
}

# Valide le motif avec le moteur qui l'exécutera (awk), et non grep :
# les deux dialectes diffèrent (\b, \w, \s...). Le motif est passé par
# l'environnement, exactement comme lors du rendu (aucune interprétation de \ ).
VALIDATE_FILTER() {
    local -i rc=0
    PSIM_FILTER="${FILTER}" "${AWK_BIN}" \
        'BEGIN { f = ENVIRON["PSIM_FILTER"]; if (f != "" && "" !~ f) exit 0 }' \
        >/dev/null 2>&1 || rc=$?
    if (( rc != 0 )); then
        ERR "filtre invalide (expression régulière) : ${FILTER}"
        return 1
    fi

    # piège classique : dans gawk, \b est un backspace (grep : limite de mot)
    if [[ "${FILTER}" == *'\b'* ]]; then
        local ver
        ver=$("${AWK_BIN}" --version 2>/dev/null | head -n 1 || true)
        if [[ "${ver}" == *"GNU Awk"* ]]; then
            WARN "dans gawk, « \\b » est un backspace : utilisez « \\y » pour une limite de mot"
        fi
    fi
    return 0
}

##############################################################################
# Main
##############################################################################
MAIN() {
    TTY=0
    [[ -t 1 ]] && TTY=1
    STDIN_TTY=0
    [[ -t 0 ]] && STDIN_TTY=1

    INIT_PATHS
    CONFIG_DEFAULTS
    DEFINE_COLORS
    CHECK_DEPS
    LOAD_CONFIG
    DEFINE_COLORS
    PARSE_ARGS "$@"
    DEFINE_COLORS

    if [[ -n "${FILTER}" ]]; then
        # volontaire : le code de retour pilote le message d'erreur déjà affiché
        # shellcheck disable=SC2310
        VALIDATE_FILTER || QUIT 2
    fi

    PREPARE_CACHE
    READ_SIZE
    SESSION=1
    trap ON_EXIT EXIT

    if (( STATIC == 1 )); then
        RUN_STATIC
        return 0
    fi
    RUN_DYNAMIC
    return 0
}

MAIN "$@"
