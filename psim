# Éclate une option courte groupée : -pn -> -p -n, -w5 -> -w 5, -ngfirefox -> -n -g firefox
EXPAND_CLUSTER() {
    local rest="${1#-}" c
    CLUSTER_ARGS=()
    while [[ -n "${rest}" ]]; do
        c="${rest:0:1}"
        rest="${rest:1}"
        case "${c}" in
            w|g)
                if [[ -n "${rest}" ]]; then
                    CLUSTER_ARGS+=("-${c}" "${rest}")
                    rest=""
                else
                    CLUSTER_ARGS+=("-${c}")
                fi
                ;;
            *)
                CLUSTER_ARGS+=("-${c}")
                ;;
        esac
    done
    return 0
}

NEED_ARG() {
    [[ -n "${2}" ]] && return 0
    ERR "l'option ${1} attend un argument."
    QUIT 2
}

PARSE_ARGS() {
    local arg
    local -i k=0 konly=0

    while (( $# > 0 )); do
        arg="$1"
        case "${arg}" in
            --) shift; break ;;
            -p|--pid)   SORT="pid";   shift ;;
            -P|--ppid)  SORT="ppid";  shift ;;
            -c|--cpu)   SORT="-%cpu"; shift ;;
            -N|--nice)  SORT="nice";   shift ;;
            -m|--mem)   SORT="-rss";  shift ;;
            -u|--user)  SORT="user";  shift ;;
            -C|--cmd)   SORT="cmd";   shift ;;
            -n|--newbie) NEWBIE=1; shift ;;
            -k|--kernel) k=1; shift ;;
            -K|--kernel-only) konly=1; shift ;;
            -H|--no-header) HEADER=0; shift ;;
            -F|--no-footer) FOOTER=0; shift ;;
            -O|--fullcmd) SHOW_OPTS=1; shift ;;
            -0|--no-color) NO_COLOR=1; shift ;;
            -M|--machine-cpu) CPU_MODE=1; shift ;;
            --per-core) CPU_MODE=0; shift ;;
            --debug) DEBUG=1; shift ;;
            -h|--help) HELP; QUIT 0 ;;
            -v|--version) VERSION; QUIT 0 ;;
            -w|--watch)
                NEED_ARG "${arg}" "${2:-}"
                # ${#2} : un entier de 19 chiffres déborde en négatif et
                # passerait le test, pour finir en « sleep: invalid option »
                if [[ ! "${2}" =~ ^[0-9]+$ ]] || (( ${#2} > 4 )) || (( 10#${2} > INTERVAL_MAX )); then
                    ERR "${arg} attend un entier entre 0 et ${INTERVAL_MAX}."
                    QUIT 2
                fi
                INTERVAL=$((10#${2}))
                (( INTERVAL == 0 )) && STATIC=1
                (( INTERVAL && LIMIT == 0 )) && STATIC=0          # -w N écrase un INTERVAL=0 de la config
                (( INTERVAL >= INTERVAL_MAX )) && FREEZE=1
                shift 2
                ;;
            -g|--filter)
                NEED_ARG "${arg}" "${2:-}"
                FILTER="$2"
                shift 2
                ;;
            --*)
                if [[ "${arg}" == --filter=* || "${arg}" == --watch=* ]]; then
                    shift
                    set -- "${arg%%=*}" "${arg#*=}" "$@"
                    continue
                fi
                if [[ "${arg}" =~ ^--([0-9]+)$ ]]; then
                    if (( ${#BASH_REMATCH[1]} > 6 )) || (( 10#${BASH_REMATCH[1]} > 10000 )); then
                        ERR "--N trop grand (maximum 10000)."
                        QUIT 2
                    fi
                    LIMIT=$((10#${BASH_REMATCH[1]}))
                    STATIC=1
                    shift
                else
                    ERR "option inconnue : ${arg}"
                    USAGE >&2
                    QUIT 2
                fi
                ;;
            -*)
                if [[ "${arg}" =~ ^-[A-Za-z0-9]{2,}$ ]]; then
                    EXPAND_CLUSTER "${arg}"
                    shift
                    set -- "${CLUSTER_ARGS[@]}" "$@"
                    continue
                fi
                ERR "option inconnue : ${arg}"
                USAGE >&2
                QUIT 2
                ;;
            *)
                ERR "argument inattendu : ${arg}"
                QUIT 2
                ;;
        esac
    done

    if (( $# > 0 )); then
        ERR "argument inattendu : $1"
        QUIT 2
    fi

    if (( k == 1 && konly == 1 )); then
        ERR "--kernel et --kernel-only sont incompatibles."
        QUIT 2
    fi
    (( konly == 1 )) && KERNEL=2
    (( k == 1 )) && KERNEL=1

    [[ "${SORT}" == "cmd" ]] && SHOW_OPTS=1
    [[ -n "${FILTER}" ]] && SHOW_OPTS=1

    # pas de terminal (sortie OU entrée) : mode statique, sans couleurs ni décor
    if (( TTY == 0 || STDIN_TTY == 0 )); then
        NO_COLOR=1
        STATIC=1
        HEADER=0
        FOOTER=0
    fi
    # mode statique : lignes seules, comme ps
    if (( STATIC == 1 )); then
        HEADER=0
        FOOTER=0
    fi
    return 0
}

##############################################################################
# Environnement
##############################################################################
INIT_PATHS() {
    local cfg_home cache_home
    # set -u ferait mourir bash sur « HOME: unbound variable », sans diagnostic
    if [[ -z "${HOME:-}" && -z "${XDG_CONFIG_HOME:-}" && -z "${XDG_CACHE_HOME:-}" ]]; then
        ERR "ni HOME ni XDG_CONFIG_HOME/XDG_CACHE_HOME : impossible de situer la configuration."
        return 1
    fi
    cfg_home="${XDG_CONFIG_HOME:-${HOME:-}/.config}"
    cache_home="${XDG_CACHE_HOME:-${HOME:-}/.cache}"
    CONFIG="${cfg_home}/${CONF_NAME}/default.conf"
    if [[ ! -f "${CONFIG}" && -f "${cfg_home}/psim/default.conf" ]]; then
        CONFIG="${cfg_home}/psim/default.conf"   # reprise de l'ancienne config
    fi
    CACHE_DIR="${cache_home}/${CONF_NAME}"
    DRAW_FILE="${CACHE_DIR}/drawn.${SELF_PID}"
    LOG_FILE="${CACHE_DIR}/log"
    return 0
}

CHECK_DEPS() {
    local -i missing=0
    PS_BIN=$(command -v ps 2>/dev/null || true)
    AWK_BIN=$(command -v awk 2>/dev/null || true)
    if [[ -z "${PS_BIN}" ]]; then ERR "commande ps introuvable."; missing=1; fi
    if [[ -z "${AWK_BIN}" ]]; then ERR "commande awk introuvable."; missing=1; fi
    (( missing == 0 )) || QUIT 1
    ME="${USER:-}"
    [[ -n "${ME}" ]] || ME=$(id -un 2>/dev/null || printf '?')
    NCPU=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')
    [[ "${NCPU}" =~ ^[0-9]+$ ]] && (( NCPU > 0 )) || NCPU=1
    return 0
}

# Le shell qui tape « psim -g zzz » porte ce motif dans sa propre ligne de
# commande : sans exclusion, il apparaît dans ses propres résultats. On remonte
# la chaîne des parents et on écarte ceux qui nomment psim.
#
# Tout est fait avec des primitives bash (aucun tr/sed/cut) : le parcours ajoute
# sinon une trentaine de forks au démarrage, ce qui coûtait plus cher que la
# lecture de taille qu'on vient d'économiser.
COLLECT_EXCLUDES() {
    EXCL_PIDS=("${SELF_PID}")
    local p="${PPID:-0}" cmd='' line='' ppid='' i=0
    local -a _argv=()
    while (( i < 12 )) && [[ "${p}" =~ ^[0-9]+$ ]] && (( p > 1 )); do
        [[ -r "/proc/${p}/cmdline" ]] || break
        mapfile -d '' -t _argv 2>/dev/null <"/proc/${p}/cmdline" || true
        cmd="${_argv[*]}"
        [[ "${cmd}" == *psim* ]] && EXCL_PIDS+=("${p}")
        ppid=''
        while IFS= read -r line; do
            if [[ "${line}" == PPid:* ]]; then
                ppid="${line#PPid:}"
                ppid="${ppid//[[:space:]]/}"
                break
            fi
        done 2>/dev/null <"/proc/${p}/status" || true
        [[ -n "${ppid}" ]] || break
        p="${ppid}"
        i=$((i + 1))
    done
    return 0
}

PREPARE_CACHE() {
    if ! mkdir -p "${CACHE_DIR}" 2>/dev/null; then
        WARN "impossible de créer ${CACHE_DIR} : journal et défilement désactivés"
        CACHE_DIR=""
        DRAW_FILE=""
        LOG_FILE=""
        LOG=0
        return 0
    fi
    chmod 700 "${CACHE_DIR}" 2>/dev/null || true
    # ménage : seulement les états d'instances mortes. Effacer drawn.* sans
    # distinction cassait le défilement d'une instance voisine (TOTAL perdu).
    local f pid
    for f in "${CACHE_DIR}"/drawn.*; do
        [[ -e "${f}" ]] || continue
        pid="${f##*.}"
        [[ "${pid}" =~ ^[0-9]+$ ]] || { rm -f "${f}" 2>/dev/null || true; continue; }
        (( pid == SELF_PID )) && continue
        [[ -d "/proc/${pid}" ]] || rm -f "${f}" 2>/dev/null || true
    done
    : > "${DRAW_FILE}" 2>/dev/null || DRAW_FILE=""
    [[ -z "${DRAW_FILE}" ]] || chmod 600 "${DRAW_FILE}" 2>/dev/null || true
    return 0
}

# La taille est lue UNE fois au lancement (deux appels tput = deux forks) puis
# seulement sur SIGWINCH : un tick ne doit forker pour rien. READ_SIZE 1 force
# la relecture.
READ_SIZE() {
    local cols lines force="${1:-0}"
    if (( force == 0 && SIZE_KNOWN == 1 )); then
        return 0
    fi
    if (( TTY == 1 )); then
        cols=$(tput cols 2>/dev/null || printf '%s' "${COLUMNS:-0}")
        lines=$(tput lines 2>/dev/null || printf '%s' "${LINES:-0}")
    else
        cols="${COLUMNS:-0}"
        lines="${LINES:-0}"
    fi
    SIZE_KNOWN=1
    [[ "${cols}"  =~ ^[0-9]+$ ]] || cols=0
    [[ "${lines}" =~ ^[0-9]+$ ]] || lines=0
    (( cols  > 0 )) || cols=120
    (( lines > 0 )) || lines=40
    WIDTH=$((cols - 1))
    HEIGHT=$((lines))
    (( WIDTH  < 1 )) && WIDTH=1
    (( HEIGHT < 1 )) && HEIGHT=1
    return 0
}

##############################################################################
# Script awk (commun ; newbie=1/0)
##############################################################################
IFS= read -r -d '' AWK_MAIN <<'AWKEOF' || true
BEGIN {
    filter = ENVIRON["PSIM_FILTER"]
    lfilter = tolower(filter)

    if (newbie) {
        f_user = 2; f_rss = 3; f_cpu = 4; f_cmd = 5; f_arg = 6
        prefix = 7 + 1 + 10 + 1 + 6 + 1 + 6 + 3
        hdr_cmd = (showopts ? "CMD" : "COMMAND")
        hdr_cpu = cpu_mode ? "%CPU/m" : "%CPU"
    } else {
        f_ppid = 2; f_user = 3; f_nice = 4; f_rss = 5
        f_mem = 6; f_cpu = 7; f_cmd = 8; f_arg = 9
        prefix = 7 + 1 + 7 + 1 + 10 + 1 + 3 + 1 + 6 + 1 + 6 + 1 + 6 + 3
        hdr_cmd = (showopts ? "CMD" : "COMMAND")
        hdr_cpu = cpu_mode ? "%CPU/m" : "%CPU"
    }
    avail = width - prefix
    if (avail < 10) avail = 10
    cmdw = (avail > 60) ? 60 : avail
    optw = avail - cmdw - 1
    if (optw < 0) optw = 0

    if (color) {
        RED = red; GREEN = green; YELLOW = yellow; BLUE = blue
        MAGENTA = magenta; CYAN = cyan; WHITE = white; GREY = grey
        BG = bg; RESET = reset; RFG = resetfg; UL = underline
        EL = "\033[0K"
    } else {
        RED = ""; GREEN = ""; YELLOW = ""; BLUE = ""
        MAGENTA = ""; CYAN = ""; WHITE = ""; GREY = ""
        BG = ""; RESET = ""; RFG = ""; UL = ""
        EL = ""
    }
    if (!pad) { cmdw = 0; optw = 0 }
    started = 0
    uloff = color ? "\033[24m" : ""
    mb = (length("é") == 1)
    cont_re = "[" sprintf("%c", 128) "-" sprintf("%c", 191) "]$"
    hdr_plain_len = prefix + length(hdr_cmd)
    emit_header()
