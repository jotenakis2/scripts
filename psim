    local format
    local -a pscmd awkcmd

    if (( NEWBIE == 1 )); then
        format="pid,user,rss,%cpu,cmd"
    else
        format="pid,ppid,user,nice,rss,%mem,%cpu,cmd"
    fi

    # le filtre passe par l'environnement : -v interpréterait les \
    PSIM_FILTER="${FILTER}"
