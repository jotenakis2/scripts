#!/usr/bin/env bash
# shellcheck enable=all
##############################################################################
# psim — mise en forme lisible de la sortie de ps.
#
# Auteur original : jotenakis (GPLv3). Réécriture corrective 2026.
#
# Différences avec psim (0.999) :
#   * utilisable dans un pipe/un fichier (plus de COLUMNS non lié, plus de
#     séquences ANSI, sortie non tronquée, une ligne par processus) ;
#   * plus aucun plantage sur un filtre sans correspondance ou invalide ;
#   * terminal toujours restauré (trap EXIT + signaux) ;
#   * une seule invocation de ps par rafraîchissement (total exact inclus) ;
#   * %CPU réel (l'ancienne version divisait par le nombre de cœurs) ;
#   * troncature/alignement corrects (plus de lignes de 194 colonnes) ;
#   * configuration validée clé par clé (plus d'évaluation de shell) ;
#   * options --no-header/--no-footer indépendantes (le statut suit l'entête :
#     il s'affiche à sa droite, ou sur une ligne en bas si l'entête est masqué) ;
#   * mode arbre (--tree / touche t) : hiérarchie des ppid, l'indentation
#     se prend sur les colonnes de commande et d'arguments ;
#   * souris en mode dynamique : clic = sélection de la ligne, double-clic =
#     détails du processus, molette = défilement de la vue ;
#   * journal borné (rotation) ;
#   * options inconnues, arguments en trop et valeurs invalides refusés.
#
# Dépendances : ps (procps-ng), awk (gawk, mawk ou busybox awk).
#               tput est optionnel.
##############################################################################
set -euo pipefail

readonly VER="1.4.1"
readonly NAME="${0##*/}"
readonly CONF_NAME="psim"       # config et cache : ~/.config/psim et ~/.cache/psim
readonly SELF_PID="${BASHPID:-$$}"

# Seuils
readonly THIN_W=100        # en dessous : mode simplifié forcé
readonly MIN_W=60          # en dessous : refus du mode dynamique
readonly MIN_H=6
readonly INTERVAL_MAX=3599 # au-delà : gel
readonly LOG_MAX=262144    # rotation du journal (octets)

# Glyphe Nerd Font du statut (horloge de l'intervalle)
readonly ICON_CLOCK=$'\uF449'

# État
declare -i WIDTH=120 HEIGHT=40
declare -i LIMIT=0 OFFSET=0 TOTAL=0
declare -i ALT=0 SESSION=0 CLEANED=0 TTY=0 STDIN_TTY=0 SIZE_KNOWN=0 WINCH=0
# Dernier événement souris (MOUSE_BTN < 0 : aucun) : bouton, ligne du curseur,
# relâchement. Renseignés par MOUSE_READ, exploités par MOUSE_ACT. La colonne
# n'est pas conservée : seule la ligne porte la sélection.
declare -i MOUSE_BTN=-1 MOUSE_Y=0 MOUSE_REL=0
# Double-clic : instant (µs) et ligne du dernier appui gauche, et drapeau posé
# par MOUSE_ACT quand deux appuis tombent sur la même ligne dans l'intervalle.
declare -i CLICK_LAST=0 CLICK_ROW=0 DOUBLE=0
declare -i CLICK_US=400000        # 400 ms : la tolérance usuelle d'un double-clic
declare -i NOWTIC=0               # horodatage courant (µs), posé par NOW_US
declare -i STATUSW=0
status_p=''
status_c=''
declare -i FILTER_EDIT=0 FILTER_INVALID=0
declare -i NEWBIE=1 INTERVAL=1 HEADER=1 FOOTER=1 NO_COLOR=0
declare -i KERNEL=0 STATIC=1 SHOW_OPTS=0 FREEZE=0 LOG=1 DEBUG=0 CPU_MODE=0
# TREE=1 : mode arbre (hiérarchie ppid), calculé par awk en fin de flux
declare -i TREE=0
# Sélection : SEL_PID est la vérité (elle suit le processus d'une trame à
# l'autre) ; SELROW/SELABS sont renseignés par awk (rang dans la fenêtre et rang
# absolu), ROWPIDS porte les PID de la fenêtre courante pour les déplacements.
declare -i SEL_PID=0 SELROW=0 SELABS=0 SELIDX=0 SELMOVED=0
declare -a ROWPIDS=()
# Boîtes (détails, confirmation de kill) : lignes déjà rendues, leur largeur
# visible, la géométrie, le décor et le titre courant
declare -a DET_ROWS=() DET_W=()
declare -i DET_INNER=0 DET_FREEZE_SAVE=0
declare SIZE_STR='' AGE_STR='' DET_NAME='?'
declare DET_GRIS='' DET_RST='' DET_HZ='' DET_BV='' DET_TL='' DET_TR='' DET_BL='' DET_BR=''
declare DET_BG='' DET_RS='' DET_HINT=''
# Terminer un processus : nom visé et résultats des helpers (drapeaux, jamais
# un code de retour de fonction testé dans une condition)
declare CMDNAME='?'
declare -i ISANC=0 ASKED=0 KILL_OK=0
declare SORT="-%cpu"
declare FILTER="" FILTER_BUF="" FILTER_SAVE=""
declare -i NCPU=1
declare PS_BIN="" AWK_BIN="" CONFIG="" CACHE_DIR="" DRAW_FILE="" LOG_FILE="" ME=""
declare STTY_SAVE=""
declare -a CLUSTER_ARGS=()

# Couleurs (remplies par DEFINE_COLORS)
Rouge="" Vert="" Jaune="" Bleu="" BleuBold="" Magenta="" Cyan="" Blanc=""
RougeBold="" Gris="" BgGris="" Reset="" ResetFg="" Underline="" Gras=""

##############################################################################
# Utilitaires
##############################################################################
ERR() { printf '%sErreur%s : %s\n' "${RougeBold}" "${Reset}" "$*" >&2; }
WARN() { printf '%sAttention%s : %s\n' "${Jaune}" "${Reset}" "$*" >&2; }

RESTORE_SCREEN() {
    if (( ALT == 1 )); then
        if [[ -n "${STTY_SAVE}" ]]; then
            stty "${STTY_SAVE}" 2>/dev/null || true
        fi
        printf '\033[?1000l\033[?1006l\033[?25h\033[?1049l\033[0m'
        ALT=0
    fi
    return 0
}

QUIT() { exit "${1:-0}"; }

DEFINE_COLORS() {
    if (( NO_COLOR == 1 )) || (( TTY == 0 )) || [[ "${TERM:-dumb}" == "dumb" ]]; then
        Rouge="" Vert="" Jaune="" Bleu="" BleuBold="" Magenta="" Cyan="" Blanc=""
        RougeBold="" Gris="" BgGris="" Reset="" ResetFg="" Underline="" Gras=""
    else
        Rouge=$'\033[31m' ; Vert=$'\033[32m' ; Jaune=$'\033[33m'
        Bleu=$'\033[34m'  ; BleuBold=$'\033[1;34m' ; Magenta=$'\033[35m'
        Cyan=$'\033[36m'  ; Blanc=$'\033[37m' ; RougeBold=$'\033[1;31m'
        Gris=$'\033[37m'  ; BgGris=$'\033[100m'
        Reset=$'\033[0m'  ; ResetFg=$'\033[39m' ; Underline=$'\033[4m'
        Gras=$'\033[1m'
    fi
    return 0
}

##############################################################################
# Configuration (parsing strict, aucune évaluation de shell)
##############################################################################
CONFIG_DEFAULTS() {
    NEWBIE=1
    INTERVAL=1
    HEADER=1
    FOOTER=1
    NO_COLOR=0
    KERNEL=0
    SHOW_OPTS=0
    SORT="-%cpu"
    FILTER=""
    LOG=1
    DEBUG=0
    CPU_MODE=0
    STATIC=0
    TREE=0
    return 0
}

SET_BOOL() {  # SET_BOOL NOM VALEUR NUMÉRO_DE_LIGNE
    local name="$1" val="$2"
    local -i line="$3"
    case "${val}" in
        0|1) printf -v "${name}" '%s' "${val}" ;;
        *)   WARN "${CONFIG}:${line}: ${name} doit valoir 0 ou 1 (ligne ignorée)"; return 1 ;;
    esac
    return 0
}

LOAD_CONFIG() {
    local line key val
    local -i n=0 bad=0

    [[ -f "${CONFIG}" ]] || return 0
    if [[ ! -r "${CONFIG}" ]]; then
        WARN "${CONFIG} illisible : configuration ignorée"
        return 0
    fi

    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "${line}" ]] && continue

        if [[ ! "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            WARN "${CONFIG}:${n}: ligne ignorée (format attendu CLÉ=VALEUR)"
            bad=$((bad + 1))
            continue
        fi
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        val="${val%\"}" ; val="${val#\"}"
        val="${val%\'}" ; val="${val#\'}"

        case "${key}" in
            NEWBIE|HEADER|FOOTER|NO_COLOR|SHOW_OPTS|LOG|DEBUG|CPU_MODE|TREE)
                # volontaire : une valeur invalide est comptée et le chargement continue
                # shellcheck disable=SC2310
                SET_BOOL "${key}" "${val}" "${n}" || bad=$((bad + 1))
                ;;
            INTERVAL)
                if [[ "${val}" =~ ^[0-9]+$ ]] && (( 10#${val} <= INTERVAL_MAX )); then
                    INTERVAL=$((10#${val}))
                    (( INTERVAL == 0 )) && STATIC=1
                    (( INTERVAL >= INTERVAL_MAX )) && FREEZE=1
                else
                    WARN "${CONFIG}:${n}: INTERVAL attend un entier 0..${INTERVAL_MAX} (ignoré)"
                    bad=$((bad + 1))
                fi
                ;;
            KERNEL)
                if [[ "${val}" =~ ^[0-2]$ ]]; then
                    KERNEL="${val}"
                else
                    WARN "${CONFIG}:${n}: KERNEL doit valoir 0, 1 ou 2 (ignoré)"
                    bad=$((bad + 1))
                fi
                ;;
            SORT)
                case "${val}" in
                    pid|-pid|ppid|-ppid|user|-user|cmd|-cmd|rss|-rss|%cpu|-%cpu|%mem|-%mem|nice|-nice)
                        SORT="${val}" ;;
                    *) WARN "${CONFIG}:${n}: tri « ${val} » inconnu (ignoré)"; bad=$((bad + 1)) ;;
                esac
                ;;
            STATS) : ;;   # ancienne clé, sans effet
            FILTER) FILTER="${val}" ;;
            *)
                WARN "${CONFIG}:${n}: clé inconnue « ${key} » (ignorée)"
                bad=$((bad + 1))
                ;;
        esac
    done < "${CONFIG}"

    (( bad == 0 )) || WARN "${bad} ligne(s) de ${CONFIG} ignorée(s)"
    return 0
}

