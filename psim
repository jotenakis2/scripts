# Éclate une option courte groupée : -pn -> -p -n, -w5 -> -w 5, -ngfirefox -> -n -g firefox
EXPAND_CLUSTER() {
    local rest="${1#-}" c
    CLUSTER_ARGS=()
    while [[ -n "${rest}" ]]; do
        c="${rest:0:1}"
        rest="${rest:1}"
        case "${c}" in
            w|g)
                if [[ -n "${rest}" ]]; then
                    CLUSTER_ARGS+=("-${c}" "${rest}")
                    rest=""
                else
                    CLUSTER_ARGS+=("-${c}")
                fi
                ;;
            *)
                CLUSTER_ARGS+=("-${c}")
                ;;
        esac
    done
    return 0
}

NEED_ARG() {
    [[ -n "${2}" ]] && return 0
    ERR "l'option ${1} attend un argument."
    QUIT 2
}

PARSE_ARGS() {
    local arg
    local -i k=0 konly=0

    while (( $# > 0 )); do
        arg="$1"
        case "${arg}" in
            --) shift; break ;;
            -p|--pid)   SORT="pid";   shift ;;
            -P|--ppid)  SORT="ppid";  shift ;;
            -c|--cpu)   SORT="-%cpu"; shift ;;
            -N|--nice)  SORT="nice";   shift ;;
            -m|--mem)   SORT="-rss";  shift ;;
            -u|--user)  SORT="user";  shift ;;
            -C|--cmd)   SORT="cmd";   shift ;;
            -n|--newbie) NEWBIE=1; shift ;;
            -k|--kernel) k=1; shift ;;
            -K|--kernel-only) konly=1; shift ;;
            -H|--no-header) HEADER=0; shift ;;
            -F|--no-footer) FOOTER=0; shift ;;
            -T|--no-tips) TIPS=0; shift ;;
            -O|--fullcmd) SHOW_OPTS=1; shift ;;
            -0|--no-color) NO_COLOR=1; shift ;;
            -M|--machine-cpu) CPU_MODE=1; shift ;;
            --per-core) CPU_MODE=0; shift ;;
            --debug) DEBUG=1; shift ;;
            -h|--help) HELP; QUIT 0 ;;
            -v|--version) VERSION; QUIT 0 ;;
            -w|--watch)
                NEED_ARG "${arg}" "${2:-}"
                if [[ ! "${2}" =~ ^[0-9]+$ ]] || (( 10#${2} > INTERVAL_MAX )); then
                    ERR "${arg} attend un entier entre 0 et ${INTERVAL_MAX}."
                    QUIT 2
                fi
                INTERVAL=$((10#${2}))
                (( INTERVAL == 0 )) && STATIC=1
                (( INTERVAL && LIMIT == 0 )) && STATIC=0          # -w N écrase un INTERVAL=0 de la config
                (( INTERVAL >= INTERVAL_MAX )) && FREEZE=1
                shift 2
                ;;
            -g|--filter)
                NEED_ARG "${arg}" "${2:-}"
                FILTER="$2"
                shift 2
                ;;
            --*)
                if [[ "${arg}" == --filter=* || "${arg}" == --watch=* ]]; then
                    shift
                    set -- "${arg%%=*}" "${arg#*=}" "$@"
                    continue
                fi
                if [[ "${arg}" =~ ^--([0-9]+)$ ]]; then
                    LIMIT=$((10#${BASH_REMATCH[1]}))
                    STATIC=1
                    shift
                else
                    ERR "option inconnue : ${arg}"
                    USAGE >&2
                    QUIT 2
                fi
                ;;
            -*)
                if [[ "${arg}" =~ ^-[A-Za-z0-9]{2,}$ ]]; then
                    EXPAND_CLUSTER "${arg}"
                    shift
                    set -- "${CLUSTER_ARGS[@]}" "$@"
                    continue
                fi
                ERR "option inconnue : ${arg}"
                USAGE >&2
                QUIT 2
                ;;
            *)
                ERR "argument inattendu : ${arg}"
                QUIT 2
                ;;
        esac
    done

    if (( $# > 0 )); then
        ERR "argument inattendu : $1"
        QUIT 2
    fi

    if (( k == 1 && konly == 1 )); then
        ERR "--kernel et --kernel-only sont incompatibles."
        QUIT 2
    fi
    (( konly == 1 )) && KERNEL=2
    (( k == 1 )) && KERNEL=1

    [[ "${SORT}" == "cmd" ]] && SHOW_OPTS=1
    [[ -n "${FILTER}" ]] && SHOW_OPTS=1

    # pas de terminal (sortie OU entrée) : mode statique, sans couleurs ni décor
    if (( TTY == 0 || STDIN_TTY == 0 )); then
        NO_COLOR=1
        STATIC=1
        HEADER=0
        FOOTER=0
        TIPS=0
    fi
    # mode statique : lignes seules, comme ps
    if (( STATIC == 1 )); then
        HEADER=0
        FOOTER=0
        TIPS=0
    fi
    return 0
}

##############################################################################
# Environnement
##############################################################################
INIT_PATHS() {
    local cfg_home cache_home
    cfg_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
    cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
    CONFIG="${cfg_home}/${CONF_NAME}/default.conf"
    if [[ ! -f "${CONFIG}" && -f "${cfg_home}/psim/default.conf" ]]; then
        CONFIG="${cfg_home}/psim/default.conf"   # reprise de l'ancienne config
    fi
    CACHE_DIR="${cache_home}/${CONF_NAME}"
    DRAW_FILE="${CACHE_DIR}/drawn.${SELF_PID}"
    LOG_FILE="${CACHE_DIR}/log"
    return 0
}

CHECK_DEPS() {
    local -i missing=0
    PS_BIN=$(command -v ps 2>/dev/null || true)
    AWK_BIN=$(command -v awk 2>/dev/null || true)
    if [[ -z "${PS_BIN}" ]]; then ERR "commande ps introuvable."; missing=1; fi
    if [[ -z "${AWK_BIN}" ]]; then ERR "commande awk introuvable."; missing=1; fi
    (( missing == 0 )) || QUIT 1
    ME="${USER:-}"
    [[ -n "${ME}" ]] || ME=$(id -un 2>/dev/null || printf '?')
    NCPU=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')
    [[ "${NCPU}" =~ ^[0-9]+$ ]] && (( NCPU > 0 )) || NCPU=1
    return 0
}

PREPARE_CACHE() {
    if ! mkdir -p "${CACHE_DIR}" 2>/dev/null; then
        WARN "impossible de créer ${CACHE_DIR} : journal et défilement désactivés"
        CACHE_DIR=""
        DRAW_FILE=""
        LOG_FILE=""
        LOG=0
        return 0
    fi
    chmod 700 "${CACHE_DIR}" 2>/dev/null || true
    # ménage : fichiers d'état laissés par des instances tuées brutalement
    rm -f "${CACHE_DIR}"/drawn.* 2>/dev/null || true
    : > "${DRAW_FILE}" 2>/dev/null || DRAW_FILE=""
    [[ -z "${DRAW_FILE}" ]] || chmod 600 "${DRAW_FILE}" 2>/dev/null || true
    return 0
}

READ_SIZE() {
    local cols lines
    if (( TTY == 1 )); then
        cols=$(tput cols 2>/dev/null || printf '%s' "${COLUMNS:-0}")
        lines=$(tput lines 2>/dev/null || printf '%s' "${LINES:-0}")
    else
        cols="${COLUMNS:-0}"
        lines="${LINES:-0}"
    fi
    [[ "${cols}"  =~ ^[0-9]+$ ]] || cols=0
    [[ "${lines}" =~ ^[0-9]+$ ]] || lines=0
    (( cols  > 0 )) || cols=120
    (( lines > 0 )) || lines=40
    WIDTH=$((cols - 1))
    HEIGHT=$((lines))
    (( WIDTH  < 1 )) && WIDTH=1
    (( HEIGHT < 1 )) && HEIGHT=1
    return 0
}

##############################################################################
# Script awk (commun ; newbie=1/0)
##############################################################################
IFS= read -r -d '' AWK_MAIN <<'AWKEOF' || true
BEGIN {
    filter = ENVIRON["PSIM_FILTER"]
    lfilter = tolower(filter)

    if (newbie) {
        f_user = 2; f_rss = 3; f_cpu = 4; f_cmd = 5; f_arg = 6
        prefix = 7 + 1 + 10 + 1 + 6 + 1 + 6 + 3
        hdr_cmd = (showopts ? "CMD" : "COMMAND")
        hdr_cpu = cpu_mode ? "%CPU/m" : "%CPU"
    } else {
        f_ppid = 2; f_user = 3; f_nice = 4; f_rss = 5
        f_mem = 6; f_cpu = 7; f_cmd = 8; f_arg = 9
        prefix = 7 + 1 + 7 + 1 + 10 + 1 + 3 + 1 + 6 + 1 + 6 + 1 + 6 + 3
        hdr_cmd = (showopts ? "CMD" : "COMMAND")
        hdr_cpu = cpu_mode ? "%CPU/m" : "%CPU"
    }
    avail = width - prefix
    if (avail < 10) avail = 10
    cmdw = (avail > 60) ? 60 : avail
    optw = avail - cmdw - 1
    if (optw < 0) optw = 0

    if (color) {
        RED = red; GREEN = green; YELLOW = yellow; BLUE = blue
        MAGENTA = magenta; CYAN = cyan; WHITE = white; GREY = grey
        BG = bg; RESET = reset; RFG = resetfg; UL = underline
        EL = "\033[0K"
    } else {
        RED = ""; GREEN = ""; YELLOW = ""; BLUE = ""
        MAGENTA = ""; CYAN = ""; WHITE = ""; GREY = ""
        BG = ""; RESET = ""; RFG = ""; UL = ""
        EL = ""
    }
    if (!pad) { cmdw = 0; optw = 0 }
    started = 0
    uloff = color ? "\033[24m" : ""
    mb = (length("é") == 1)
    cont_re = "[" sprintf("%c", 128) "-" sprintf("%c", 191) "]$"
    hdr_plain_len = prefix + length(hdr_cmd)
    emit_header()
}

# Tronque sans couper un caractère UTF-8 (awk non multibyte : mawk, busybox)
function cut(s, n) {
    s = substr(s, 1, n)
    if (!mb) { while (s ~ cont_re) s = substr(s, 1, length(s) - 1) }
    return s
}

# Colonne d'en-tête colorée, soulignée si c'est la colonne de tri active.
function hc(txt, col, active) {
    return (active ? UL : "") col txt (active ? uloff : "") RFG
}

# Émet une ligne sans newline final : le curseur reste sur la dernière ligne,
# ce qui évite de faire défiler l'écran d'une ligne à chaque rafraîchissement.
function emit(s) {
    if (!started) { printf "%s", s; started = 1 }
    else          { printf "\n%s", s }
}

function emit_header() {
    if (header && pad) {
        if (newbie) {
            hdr = BG \
                hc(sprintf("%7s", "PID"), MAGENTA, sort ~ /^-?pid$/) " " \
                hc(sprintf("%-10s", "USER"), BLUE, sort ~ /^-?user$/) " " \
                hc(sprintf("%6s", "MiB"), GREEN, sort ~ /^-?rss$/) " " \
                hc(sprintf("%6s", hdr_cpu), GREEN, sort ~ /^-?%?cpu$/) "   " \
                hc(hdr_cmd, YELLOW, sort ~ /^-?%?cmd$/)
        } else {
            hdr = BG \
                hc(sprintf("%7s", "PID"), MAGENTA, sort ~ /^-?pid$/) " " \
                hc(sprintf("%7s", "PPID"), CYAN, sort ~ /^-?ppid$/) " " \
                hc(sprintf("%-10s", "USER"), BLUE, sort ~ /^-?user$/) " " \
                hc(sprintf("%3s", "NI"), WHITE, sort ~ /^-?nice$/) " " \
                hc(sprintf("%6s", "MiB"), GREEN, sort ~ /^-?rss$/) " " \
                hc(sprintf("%6s", "%MEM"), GREEN, 0) " " \
                hc(sprintf("%6s", hdr_cpu), GREEN, sort ~ /^-?%?cpu$/) "   " \
                hc(hdr_cmd, YELLOW, sort ~ /^-?%?cmd$/)
        }
        pad_h = width - hdr_plain_len
        if (pad_h < 0) pad_h = 0
        emit(sprintf("%s%s%s%s", hdr, sprintf("%*s", pad_h, ""), EL, RESET))
    }
}

{
    cmd = $f_cmd
    # thread noyau = nom entre crochets, mais PAS un zombie ([nom] <defunct>)
    # (« <defunct> » est un champ séparé : on teste la ligne entière)
    is_kernel = (substr(cmd, 1, 1) == "[" && $0 !~ /<defunct>$/)

    if (kernel == 0 && is_kernel) next
    if (kernel == 2 && !is_kernel) next

    args = ""
    if (NF >= f_arg) {
        for (i = f_arg; i <= NF; i++) args = args (i > f_arg ? " " : "") $i
    }

    if (filter != "") {
        search = tolower($f_user " " cmd " " args)
        if (search !~ lfilter) next
    }

    # mode « options » désactivé : nom de commande seul, sans chemin ni arguments
    if (showopts == 0 && !is_kernel) {
        sub(/^.*\//, "", cmd)
        args = ""
    }

    total++
    if (total <= offset) next
    if (limit > 0 && shown >= limit) next

    rss = $f_rss / 1024
    cpu = cpu_mode ? $f_cpu / ncpu : $f_cpu
    shown++
    sum_rss += rss
    sum_cpu += $f_cpu
    if (!newbie) sum_mem += $f_mem

    if (!pad) {
        if (newbie)
            printf "%s %s %.0f %.1f %s%s\n", $1, $f_user, rss, cpu, cmd, (args != "" ? " " args : "")
        else
            printf "%s %s %s %s %.0f %.1f %.1f %s%s\n", $1, $f_ppid, $f_user, $f_nice, rss, $f_mem, cpu, cmd, (args != "" ? " " args : "")
        next
    }

    cmd_d = cut(cmd, cmdw)
    pad_n = cmdw - length(cmd_d)
    if (pad_n < 0) pad_n = 0

    if (showopts && cmd_d ~ /\//) {
        match(cmd_d, /\/[^\/]*$/)
        dir_p = substr(cmd_d, 1, RSTART)
        base_p = substr(cmd_d, RSTART + 1)
        cmd_c = GREY dir_p RESET YELLOW base_p RESET sprintf("%*s", pad_n, "")
    } else {
        cmd_c = YELLOW cmd_d RESET sprintf("%*s", pad_n, "")
    }

    if ($f_user == "root")
        user_c = RED substr($f_user, 1, 10) RESET sprintf("%*s", 10 - length(substr($f_user, 1, 10)), "")
    else if ($f_user == me)
        user_c = BLUE substr($f_user, 1, 10) RESET sprintf("%*s", 10 - length(substr($f_user, 1, 10)), "")
    else
        user_c = substr($f_user, 1, 10) sprintf("%*s", 10 - length(substr($f_user, 1, 10)), "")

    if (newbie) {
        line = MAGENTA sprintf("%7d", $1) RESET " " user_c " " \
               GREEN sprintf("%6.0f", rss) RESET " " GREEN sprintf("%6.1f", cpu) RESET "   " cmd_c
    } else {
        if ($f_nice == "-")      nice_c = GREY sprintf("%3s", $f_nice) RESET
        else if ($f_nice < 0)    nice_c = YELLOW sprintf("%3s", $f_nice) RESET
        else                     nice_c = CYAN sprintf("%3s", $f_nice) RESET

        line = MAGENTA sprintf("%7d", $1) RESET " " CYAN sprintf("%7d", $f_ppid) RESET " " \
               user_c " " nice_c " " GREEN sprintf("%6.0f", rss) RESET " " \
               GREEN sprintf("%6.1f", $f_mem) RESET " " GREEN sprintf("%6.1f", cpu) RESET "   " cmd_c
    }

    if (optw > 0 && args != "")
        line = line " " GREY cut(args, optw) RESET

    emit(line EL)
}

END {
    if (drawfile != "")
        printf "%d %d\n", shown, total > drawfile

    if (pad) {
        for (i = shown; i < limit; i++) emit(EL)
    }
    if (footer && pad) {
        # le pied de page suit le mode d'affichage des lignes
        norm = cpu_mode ? ((ncpu > 0) ? sum_cpu / ncpu : sum_cpu) : sum_cpu
        tail = sprintf("%d/%d proc", shown, total)
        if (newbie)
            head = sprintf("%-18s %6.0f %6.1f   ", "TOTAL (displayed)", sum_rss, norm)
        else
            head = sprintf("%-30s %6.0f %6.1f %6.1f   ", "TOTAL (displayed)", sum_rss, sum_mem, norm)
        room = width - length(head)
        if (room < 0) room = 0
        emit(RED head substr(tail, 1, room) RESET EL)
    }
}
