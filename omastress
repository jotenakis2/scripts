#!/usr/bin/env bash
# shellcheck enable=all
# shellcheck shell=bash
#
# SC2312 : les substitutions $(cfg_get …), $(icon_of …) sont de la pure
#   mise en forme ; leur code retour est volontairement ignoré (le script
#   n'utilise pas « set -e », une erreur d'affichage ne doit rien interrompre).
# SC2329 : tool_* et worker_cleanup/on_exit sont appelés indirectement
#   (via ${tool}, « trap … EXIT »), ce que shellcheck ne peut pas suivre.
# shellcheck disable=SC2312,SC2329
#
# omastress — session de stress CPU / DISK / NET / RAM, interface gum.
#
#   • 4 modules indépendants, lançables ensemble ou séparément
#   • paliers de montée/descente réglables, cycles, durée de palier
#   • tableau de bord temps réel, arrêt immédiat par « q »
#   • rapport CSV par session, alerte et arrêt thermique
#
# Dépendances : gum, stress-ng, fio, iperf3.
# Essai sans charge : omastress --demo

set -uo pipefail  # pas de -e : une erreur d'affichage ne doit pas tuer la session
export LC_NUMERIC=C  # nombres à point (PSI, awk) quel que soit le locale

readonly SCRIPT_VERSION="1.1"
readonly SCRIPT_NAME="${0##*/}"

