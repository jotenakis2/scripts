multi_session() { # $1="all" pour tout présélectionner
  local -A on=([cpu]=0 [disk]=0 [net]=0 [ram]=0)
  local -a order=(cpu disk net ram) opts=() picked=()
  local choice mod dur mark count preset="${1:-}"
  if [[ ${preset} == all ]]; then
    on=([cpu]=1 [disk]=1 [net]=1 [ram]=1)
  fi

  while true; do
    clear
    count=0
    opts=()
    for mod in "${order[@]}"; do
      if (( on[${mod}] )); then
        mark="${I_CHECK}"
        count=$(( count + 1 ))
      else
        mark="${I_LEFT}"
      fi
      opts+=("${mark}  $(summary_line "${mod}")")
    done
    opts+=("${I_PLAY}  Valider la sélection" "${I_LEFT}  Retour")
    if [[ ${preset} == all ]]; then
      header "${I_PLAY}  Session complète" "les 4 modules sont déjà cochés — décocher si besoin"
    else
      header "${I_PLAY}  Session multi-modules" \
        "Entrée pour cocher ou décocher un module"
    fi
    style_block "${C_MUTED}" \
      "   Chaque module garde ses propres paliers et cycles." \
      "   ${I_CHECK} = sélectionné · ${I_LEFT} = non sélectionné · ${count} $(plural "${count}" module modules) $(plural "${count}" coché cochés)"
    echo
    choice=$(gum choose --height 8 --header "Choisir" "${opts[@]}") || return 0
    case "${choice}" in
      *CPU*) on[cpu]=$(( 1 - on[cpu] )) ;;
      *DISK*) on[disk]=$(( 1 - on[disk] )) ;;
      *NET*) on[net]=$(( 1 - on[net] )) ;;
      *RAM*) on[ram]=$(( 1 - on[ram] )) ;;
      *Valider*) (( count > 0 )) && break ;;
      *) return 0 ;;
    esac
  done

  for mod in "${order[@]}"; do
    (( on[${mod}] )) && picked+=("${mod}")
  done

  clear
  header "${I_PLAY}  Récapitulatif" "${#picked[@]} $(plural "${#picked[@]}" module modules) $(plural "${#picked[@]}" sélectionné sélectionnés)"
  for mod in "${picked[@]}"; do
    build_phases "${mod}"
    dur=$(( $(phase_total) * $(cfg_get "${mod}_cycles") ))
    gum style --foreground "$(color_of "${mod}")" --padding "0 0 0 3" \
      "$(summary_line "${mod}")"
    gum style --foreground "${C_MUTED}" --padding "0 0 0 5" \
      "  ${I_TIMER}  durée estimée $(human_duration "${dur}") · pic $(fmt_limit "${mod}" "$(cfg_get "${mod}_max")")"
  done
  echo
  if [[ " ${picked[*]} " == *" ram "* ]] && (( $(cfg_get ram_max) > 50 )); then
    if (( $(cfg_get ram_max) > 100 )); then
      gum style --foreground "${C_RED}" --padding "0 0 0 3" \
        "${I_ALERT}  RAM > 100 % : débordement sur le swap, risque de gel prolongé."
    else
      gum style --foreground "${C_RED}" --padding "0 0 0 3" \
        "${I_ALERT}  RAM > 50 % alloués : le système peut swapper ou figer."
    fi
  fi
  gum style --foreground "${C_MUTED}" --padding "0 0 0 3" \
    "${I_STOP}  Pendant la session, « q » arrête tout immédiatement."
  echo
  if ! gum confirm --affirmative "Lancer" --negative "Annuler" "Démarrer la session ?"; then
    return 0
  fi
  run_session "${picked[@]}"
}

