summary_line() { # $1=module  -> colonnes de largeur fixe
  local mod="${1}" max steps cycles dwell extra="" col_max col_steps col_cycles
  max=$(cfg_get "${mod}_max")
  steps=$(cfg_get "${mod}_steps")
  cycles=$(cfg_get "${mod}_cycles")
  dwell=$(cfg_get "${mod}_dwell")
  if (( $(term_width) >= 72 )); then
    case "${mod}" in
      disk) extra="  → $(cfg_get disk_target)" ;;
      net) extra="  → $(net_mode_label "$(cfg_get net_mode)")" ;;
      *) ;;
    esac
  fi
  local max_txt
  max_txt=$(fmt_limit "${mod}" "${max}")
  printf -v col_max '%4s %-6s' "${max_txt% *}" "${max_txt##* }"
  printf -v col_steps '%2s %-10s' "${steps}" "$(plural "${steps}" 'palier ' 'paliers')"
  printf -v col_cycles '%2s %-8s' "${cycles}" "$(plural "${cycles}" 'cycle ' 'cycles')"
  printf '%s  %-4s %s %s %s %3s s%s' \
    "$(icon_of "${mod}")" "$(label_of "${mod}")" "${col_max}" \
    "${col_steps}" "${col_cycles}" "${dwell}" "${extra}"
}

