report_open() {
  local stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p "${REPORT_DIR}"
  report_path="${REPORT_DIR}/session-${stamp}.csv"
  printf 'horodatage,module,cycle,phase,niveau,cpu_pct,ram_pct,disque_pct,net_mbit,temp_c\n' \
    > "${report_path}"
}

report_line() { # $1=module
  read_state "${1}"
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S)" "${1}" "${ST_CYCLE}" "${ST_PHASE}" "${ST_LEVEL}" \
    "${CPU_PCT}" "${RAM_PCT}" "${DISK_PCT}" "$(( NET_BPS / 1000000 ))" "${TEMP_C}" \
    >> "${report_path}"
