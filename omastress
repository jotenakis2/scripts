  while true; do
    clear
    header "${I_SPEED}  OMASTRESS" "CPU · DISK · NET · RAM · paliers & cycles"
    style_block "${C_MUTED}" \
      "   $(summary_line cpu)" \
      "   $(summary_line disk)" \
      "   $(summary_line net)" \
      "   $(summary_line ram)" \
      "" \
      "   ${I_THERMO}  alerte $(cfg_get g_temp_alert) °C · arrêt $(cfg_get g_temp_abort) °C$( (( $(term_width) >= 64 )) && printf ' · %s cœurs · %s RAM' "$(nproc)" "${ram_gb}")" \
      "   ${I_FILE}  ${CONFIG_FILE}"
    echo
    choice=$(gum choose --height 13 --header "Menu" \
      "${I_PLAY}  Session complète (4 modules)" \
      "${I_LIST}  Choisir les modules…" \
      "${I_CPU}  CPU seul" \
      "${I_DISK}  DISK seul" \
      "${I_NET}  NET seul" \
      "${I_RAM}  RAM seul" \
      "${I_COG}  Réglages" \
      "${I_CHART}  Rapports" \
      "${I_EXIT}  Quitter") || return 1
    case "${choice}" in
      *Session\ complète*) multi_session all ;;
      *Choisir\ les\ modules*) multi_session ;;
      *"CPU seul") module_menu cpu ;;
      *"DISK seul") module_menu disk ;;
      *"NET seul") module_menu net ;;
      *"RAM seul") module_menu ram ;;
      *Réglages*) global_settings ;;
      *Rapports*) reports_menu ;;
      *Quitter*) return 1 ;;
      *) ;;
    esac
  done
}

#--- CLI -------------------------------------------------------------------------------------------------------------------------
usage() {
  cat <<EOF
${SCRIPT_NAME} ${SCRIPT_VERSION} — stress CPU / DISK / NET / RAM (interface gum)

Usage : ${SCRIPT_NAME} [options]

  --demo        simule les modules (aucune charge réelle, durées courtes)
  --settings    ouvre directement les réglages
  --help        affiche cette aide

Configuration : ${CONFIG_FILE}
Rapports      : ${REPORT_DIR}
EOF
}

migrate_old_paths() { # reprend config et rapports de l'ancien nom
  local old_cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/stress4"
  local old_state="${XDG_STATE_HOME:-${HOME}/.local/state}/stress4"
  [[ -d ${old_cfg} && ! -e ${CONFIG_DIR} ]] && cp -r "${old_cfg}" "${CONFIG_DIR}" 2>/dev/null || true
  [[ -d ${old_state} && ! -e ${STATE_DIR} ]] && cp -r "${old_state}" "${STATE_DIR}" 2>/dev/null || true
  return 0
}

cli() {
  local arg mod
  for arg in "$@"; do
    case "${arg}" in
      --demo) DEMO=1 ;;
      --settings) CLI_SETTINGS=1 ;;
      --help | -h) usage; exit 0 ;;
      *)
        printf 'Option inconnue : %s\n' "${arg}" >&2
        exit 2
        ;;
    esac
  done

  if ! command -v gum > /dev/null 2>&1; then
    printf 'gum est requis : pkexec pacman -S --needed gum\n' >&2
    exit 1
  fi
  theme_load
  init_braille
  BOX_W=$(box_width)
  cfg_defaults
  migrate_old_paths
  cfg_load
  NET_MODE_EFF=$(cfg_get net_mode)
  trap on_exit EXIT
  trap 'INTERRUPT=1' INT TERM

  if (( DEMO == 0 )) && ! check_deps; then
    exit 1
  fi

  if (( DEMO )); then
    cfg_set g_hold 3
    cfg_set g_poll 1
    for mod in cpu ram disk net; do
      cfg_set "${mod}_dwell" 2
      cfg_set "${mod}_steps" 3
      cfg_set "${mod}_cycles" 1
    done
  fi

  mkdir -p "${STATE_DIR}" "${REPORT_DIR}"

  if (( CLI_SETTINGS )); then
    global_settings
  fi
  main_menu
  clear
  gum style --foreground "${C_ACCENT}" --bold "  ${I_CHECK}  À bientôt."
  exit 0
}

cli "$@"
