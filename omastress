#--- Thème Omarchy ---------------------------------------------------------------------------------------------------------------
THEME_FILE=""

theme_find() {
  local f
  for f in \
    "${HOME}/.local/state/omarchy/current/theme/colors.toml" \
    "${HOME}/.config/omarchy/current/theme/colors.toml" \
    "${OMARCHY_PATH:-/usr/share/omarchy}/current/theme/colors.toml"; do
    if [[ -r ${f} ]]; then
      THEME_FILE=${f}
      return 0
    fi
  done
  return 1
}

theme_color() {
  local key="${1}" fallback="${2}" val=""
  if [[ -n ${THEME_FILE} ]]; then
    val=$(sed -nE "s/^${key}[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\".*/\1/p" "${THEME_FILE}" | head -n 1)
  fi
  printf '%s\n' "${val:-${fallback}}"
}

theme_load() {
  theme_find || true
  C_FG=$(theme_color foreground "#eae6ee")
  C_MUTED=$(theme_color muted "#705881")
  C_ACCENT=$(theme_color accent "#ec4df0")
  C_RED=$(theme_color red "#fe1e9c")
  C_GREEN=$(theme_color green "#1ce3c0")
  C_YELLOW=$(theme_color yellow "#fee4b7")
  C_ORANGE=$(theme_color orange "#fda184")
  C_BLUE=$(theme_color blue "#7b6bfd")
  C_CYAN=$(theme_color cyan "#23e7e1")
  C_MAGENTA=$(theme_color magenta "#ec4df0")
  C_BG=$(theme_color background "#0b0113")

  export GUM_CHOOSE_CURSOR_FOREGROUND="${C_ACCENT}"
  export GUM_CHOOSE_SELECTED_FOREGROUND="${C_GREEN}"
  export GUM_CHOOSE_HEADER_FOREGROUND="${C_CYAN}"
  export GUM_CONFIRM_SELECTED_BACKGROUND="${C_GREEN}"
  export GUM_CONFIRM_SELECTED_FOREGROUND="${C_BG}"
  export GUM_CONFIRM_UNSELECTED_BACKGROUND="${C_BG}"
  export GUM_CONFIRM_UNSELECTED_FOREGROUND="${C_FG}"
