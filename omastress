module_settings() { # $1=module
  local mod="${1}" max_label max_step choice path host url
  case "${mod}" in
    cpu) max_label="Charge CPU max (%)" max_step=100 ;;
    ram) max_label="RAM à allouer max (% de la RAM totale)" max_step=120 ;;
    disk) max_label="Débit disque max (Mo/s)" max_step=8000 ;;
    net) max_label="Débit réseau max (Mbit/s)" max_step=100000 ;;
    *) return 0 ;;
  esac
  clear
  header "${I_TUNE}  Réglages $(label_of "${mod}")" "chaque valeur est enregistrée"
  ask_int "${mod}_max" "${max_label}" 1 "${max_step}" || return 0
  if [[ ${mod} == ram ]] && (( $(cfg_get ram_max) > 50 )); then
    local msg="Plus de 50 % de RAM : le système peut swapper. Continuer ?"
    if (( $(cfg_get ram_max) > 100 )); then
      msg="Plus de 100 % : débordement sur le swap, risque de gel prolongé. Continuer ?"
    fi
    if ! gum confirm --affirmative "Continuer" --negative "Ramener à 50 %" "${msg}"; then
      cfg_set ram_max 50
      gum style --foreground "${C_YELLOW}" "  ${I_ALERT}  ramené à 50 %"
    fi
  fi
  ask_int "${mod}_steps" "Nombre de paliers" 1 20 || return 0
  ask_int "${mod}_cycles" "Nombre de cycles" 1 20 || return 0
  ask_int "${mod}_dwell" "Durée d'un palier (s)" 2 600 || return 0

  case "${mod}" in
    disk)
      choice=$(gum choose --height 5 --header "Cible disque" \
        "${I_FILE}  Fichier réel (${DISK_PROBE})" \
        "${I_RAM}  Mémoire tmpfs /dev/shm (aucune usure)" \
        "${I_TUNE}  Autre chemin…") || return 0
      case "${choice}" in
        *Fichier*) cfg_set disk_target file ;;
        *Mémoire*) cfg_set disk_target tmpfs ;;
        *)
          path=$(gum input --header "Chemin du fichier ou du périphérique" --prompt "➜ " \
            --value "$(cfg_get disk_target)") || return 0
          [[ -n ${path} ]] && cfg_set disk_target "${path}"
          ;;
      esac
      ;;
    net)
      choice=$(gum choose --height 6 --header "Mode réseau" \
        "${I_NET}  Local — boucle locale, aucun réseau sollicité" \
        "${I_NET}  Passerelle — iperf3 sur la box, repli local" \
        "${I_NET}  Distant — serveur iperf3 à fournir" \
        "${I_NET}  Internet — téléchargement saturant, sans serveur") || return 0
      case "${choice}" in
        *Local*)
          cfg_set net_mode local
          cfg_set net_host 127.0.0.1
          ;;
        *Passerelle*)
          cfg_set net_mode gateway
          ask_int net_port "Port iperf3 de la passerelle" 1 65535 || true
          ;;
        *Distant*)
          host=$(gum input --header "Hôte iperf3 (IP ou nom)" --prompt "➜ " \
            --value "$(cfg_get net_host)") || return 0
          [[ -n ${host} ]] && cfg_set net_host "${host}"
          cfg_set net_mode remote
          ask_int net_port "Port iperf3 distant" 1 65535 || true
          ;;
        *Internet*)
          url=$(gum input --header "URL du fichier de test (gros fichier conseillé)" --prompt "➜ " \
            --value "$(cfg_get net_url)") || return 0
          [[ -n ${url} ]] && cfg_set net_url "${url}"
          cfg_set net_mode http
          ;;
        *) return 0 ;;
      esac
      ;;
    *) ;;
  esac
  cfg_save
  gum style --foreground "${C_GREEN}" "  ${I_CHECK}  Réglages enregistrés"
  sleep 0.6
}

