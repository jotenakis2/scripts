show_report() {
  local file="${1}" rows view
  if [[ ! -r ${file} ]]; then
    gum style --foreground "${C_RED}" "  ${I_ALERT}  Aucun rapport"
    return 1
  fi
  rows=$(awk 'END{print NR}' "${file}")
  if (( rows < 3 )); then
    gum pager < "${file}"
    return 0
  fi
  # vue compacte : heure seule, en-têtes courts, tableau défilable dans gum
  view=$(mktemp "${TMPDIR:-/tmp}/omastress-view.XXXXXX.csv")
  awk -F, 'NR == 1 {
             print "heure,mod,cyc,phase,niv,cpu,ram,disq,net,degC"
             next
           }
           { sub(/^.*T/, "", $1); print }' OFS=, "${file}" > "${view}"
  if command -v less > /dev/null 2>&1; then
    gum table --file "${view}" --print --border rounded --separator "," \
      --padding "0 0" --widths 8,4,3,11,4,4,4,5,5,4 \
      --border.foreground "${C_ACCENT}" --header.foreground "${C_CYAN}" \
      | less -SR
  else
    gum table --file "${view}" --print --border rounded --separator "," \
      --padding "0 0" --widths 8,4,3,11,4,4,4,5,5,4 \
      --border.foreground "${C_ACCENT}" --header.foreground "${C_CYAN}" \
      | gum pager
  fi
  rm -f "${view}"
  gum style --foreground "${C_MUTED}" \
    "  niv = palier cible · cpu/ram/disq en % · net en Mbit/s · degC en °C"
  gum style --foreground "${C_MUTED}" --padding "0 0 0 3" "${I_FILE}  ${file}"
}

#--- Session ---------------------------------------------------------------------------------------------------------------------
stop_workers() {
  local mod f pid
  [[ -n ${RUNDIR} ]] && touch "${RUNDIR}/stop"
  for mod in "${!WPID[@]}"; do
    kill -TERM "${WPID[${mod}]}" 2>/dev/null || true
  done
  sleep 0.4
  for mod in "${!WPID[@]}"; do
    kill -KILL "${WPID[${mod}]}" 2>/dev/null || true
  done
  if [[ -n ${RUNDIR} ]]; then
    shopt -s nullglob
    for f in "${RUNDIR}"/*.toolpid; do
      pid=$(< "${f}")
      kill_tree "${pid}"
      rm -f "${f}"
    done
    shopt -u nullglob
  fi
  stop_net_server
}

session_summary() {
  local elapsed="${1}" rows peak_cpu peak_ram peak_temp
  printf '\n'
  gum style --foreground "${C_GREEN}" --bold "  ${I_CHECK}  Session terminée en $(human_duration "${elapsed}")"
  if [[ -n ${report_path} && -s ${report_path} ]]; then
    rows=$(awk 'END{print NR-1}' "${report_path}")
    peak_cpu=$(awk -F, 'NR>1 && $6+0>m {m=$6+0} END{printf "%d", m}' "${report_path}")
    peak_ram=$(awk -F, 'NR>1 && $7+0>m {m=$7+0} END{printf "%d", m}' "${report_path}")
    peak_temp=$(awk -F, 'NR>1 && $10+0>m {m=$10+0} END{printf "%d", m}' "${report_path}")
    gum style --foreground "${C_MUTED}" \
      "  ${I_TABLE}  ${rows} $(plural "${rows}" échantillon échantillons) · pic CPU ${peak_cpu} % · pic RAM ${peak_ram} % · pic ${peak_temp} °C"
    gum style --foreground "${C_MUTED}" "  ${I_FILE}  ${report_path}"
  fi
  if (( NET_USED )); then
    local net_txt note note_max
    net_txt="  ${I_NET}  $(net_mode_label "${NET_MODE_EFF}") · interface ${NET_DEV}"
    gum style --foreground "${C_MUTED}" "${net_txt}"
    if [[ -n ${NET_NOTE} ]]; then
      note_max=$(( $(term_width) - 10 ))
      note="${NET_NOTE}"
      if (( ${#note} > note_max )); then note="${note:0:note_max-1}…"; fi
      gum style --foreground "${C_MUTED}" "       ${note}"
    fi
  fi
}

run_session() { # $1...=modules
  local -a mods=("$@")
  local mod key elapsed start now poll abort_t alert_t alive abort_msg=""
  poll=$(cfg_get g_poll)
  abort_t=$(cfg_get g_temp_abort)

  RUNDIR=$(mktemp -d "${TMPDIR:-/tmp}/omastress.XXXXXX")
  WPID=()
  # shellcheck disable=SC2034
  CPU_HIST=() RAM_HIST=() DISK_HIST=() NET_HIST=() TEMP_HIST=()
  report_open
  if [[ " ${mods[*]} " == *" net "* ]]; then
    NET_USED=1
    net_prepare
  else
    NET_USED=0
    NET_MODE_EFF=$(cfg_get net_mode)
  fi
  sample_init

  for mod in "${mods[@]}"; do
    worker_main "${mod}" &
    WPID["${mod}"]=$!
  done

  start=$(date +%s)
  INTERRUPT=0
  tput civis 2>/dev/null || true
  printf '\033[2J'
  while true; do
    now=$(date +%s)
    elapsed=$(( now - start ))
    sample_all
    for mod in "${mods[@]}"; do
      report_line "${mod}" 2>/dev/null || true
    done
    render_dashboard "${elapsed}" "${mods[@]}"

    # l'alerte thermique s'affiche dans l'en-tête : aucune ligne ajoutée,
    # donc aucun décalage de l'interface pendant la session
    if (( TEMP_C >= abort_t )); then
      abort_msg="Arrêt thermique : ${TEMP_C} °C (seuil ${abort_t} °C)"
      break
    fi

    read -r -s -n 1 -t "${poll}" key || key=""
    case "${key}" in
      q | Q | x | X) break ;;
      *) ;;
    esac
    (( INTERRUPT )) && break

    alive=0
    for mod in "${mods[@]}"; do
      if kill -0 "${WPID[${mod}]}" 2>/dev/null; then
        alive=$(( alive + 1 ))
      fi
    done
    (( alive == 0 )) && break
  done

  tput cnorm 2>/dev/null || true
  stop_workers
  for mod in "${mods[@]}"; do
    wait "${WPID[${mod}]}" 2>/dev/null || true
  done

  # on laisse le dernier tableau de bord à l'écran, avec les graphes
  elapsed=$(( $(date +%s) - start ))
  render_dashboard "${elapsed}" "${mods[@]}"
  if [[ -n ${abort_msg} ]]; then
    printf '  %s%s  %s%s\n' "$(ansi_fg "${C_RED}")" "${I_ALERT}" "${abort_msg}" $'\033[0m'
  fi
  printf '  %s%s  Entrée pour quitter%s\n' "$(ansi_fg "${C_ACCENT}")" "${I_STOP}" $'\033[0m'
  read -r _ || true
  printf '\033[2J\033[H'
  session_summary "${elapsed}"
  printf '\n'
  if gum confirm --affirmative "  ${I_CHART}  Ouvrir le rapport" --negative "  ${I_LEFT}  Menu" \
    "  Rapport de session ?"; then
    show_report "${report_path}"
  fi
}

